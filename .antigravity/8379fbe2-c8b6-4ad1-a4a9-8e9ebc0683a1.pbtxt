    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { FoodSpot } from \'../types\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { X, Navigation, Heart, Trash2, Flame, MapPin, Sparkles } from \'lucide-react\';\nimport { FastImage } from \'./FastImage\';\nimport { sound } from \'../utils/audioFeedback\';\n\ninterface SavedPocketsModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  savedSpots: FoodSpot[];\n  onRemoveSave: (spot: FoodSpot) => void;\n  onNavigate: (spot: FoodSpot) => void;\n}\n\nexport const SavedPocketsModal: React.FC<SavedPocketsModalProps> = ({\n  isOpen,\n  onClose,\n  savedSpots,\n  onRemoveSave,\n  onNavigate,\n}) => {\n  if (!isOpen) return null;\n\n  return (\n    <AnimatePresence>\n      <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-stone-950/80 backdrop-blur-md\">\n        <motion.div\n          initial={{ opacity: 0, scale: 0.95, y: 15 }}\n          animate={{ opacity: 1, scale: 1, y: 0 }}\n          exit={{ opacity: 0, scale: 0.95, y: 15 }}\n          className=\"w-full max-w-md bg-stone-900 border border-stone-800 rounded-3xl p-5 shadow-2xl flex flex-col max-h-[85vh] overflow-hidden\"\n        >\n          {/* Header */}\n          <div className=\"flex items-center justify-between pb-3 border-b border-stone-800\">\n            <div className=\"flex items-center gap-2\">\n              <div className=\"w-8 h-8 rounded-xl bg-rose-500/20 text-rose-400 flex items-center justify-center\">\n                <Heart className=\"w-4 h-4 fill-rose-500\" />\n              </div>\n              <div>\n                <h3 className=\"text-sm font-bold text-stone-100\">Saved Cheap Eats</h3>\n                <p className=\"text-[11px] text-stone-400\">{savedSpots.length} bookmarked spots</p>\n              </div>\n            </div>\n            <button\n              onClick={() => {\n                sound.playClick();\n                onClose();\n              }}\n              className=\"p-1.5 rounded-full bg-stone-800 text-stone-300 hover:text-white\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n          </div>\n\n          {/* List of Saved Spots */}\n          <div className=\"mt-4 space-y-3 overflow-y-auto flex-1 pr-1\">\n            {savedSpots.length === 0 ? (\n              <div className=\"py-12 text-center text-stone-400\">\n                <Heart className=\"w-8 h-8 mx-auto text-stone-600 mb-2\" />\n                <p className=\"text-xs font-semibold text-stone-300\">No saved food spots yet</p>\n                <p className=\"text-[11px] text-stone-500 mt-1\">\n                  Swipe right or tap the heart icon on any card to save it for quick access.\n                </p>\n              </div>\n            ) : (\n              savedSpots.map((spot) => (\n                <div\n                  key={spot.id}\n                  className=\"p-3 rounded-2xl bg-stone-950/70 border border-stone-800 flex items-center justify-between gap-3\"\n                >\n                  <div className=\"flex items-center gap-3 min-w-0\">\n                    <div className=\"w-14 h-14 rounded-xl overflow-hidden shrink-0 border border-stone-700\">\n                      <FastImage src={spot.image} alt={spot.name} className=\"w-full h-full\" />\n                    </div>\n                    <div className=\"min-w-0\">\n                      <div className=\"text-xs font-bold text-stone-100 truncate\">{spot.name}</div>\n                      <div className=\"text-[11px] text-amber-400 font-semibold truncate flex items-center gap-1 mt-0.5\">\n                        <Flame className=\"w-3 h-3\" />\n                        <span>${spot.topDeal.price.toFixed(2)} \342\200\242 {spot.topDeal.item}</span>\n                      </div>\n                      <div className=\"text-[10px] text-stone-400 truncate mt-0.5\">\n                        {spot.distanceMeters}m away \342\200\242 {spot.walkingTimeSeconds}s walk\n                      </div>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-1.5 shrink-0\">\n                    <button\n                      onClick={() => {\n                        sound.playSuccess();\n                        onNavigate(spot);\n                        onClose();\n                      }}\n                      className=\"p-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-stone-950 font-bold text-xs flex items-center gap-1 transition-colors\"\n                      title=\"Walk there\"\n                    >\n                      <Navigation className=\"w-3.5 h-3.5 fill-stone-950\" />\n                    </button>\n                    <button\n                      onClick={() => {\n                        sound.playClick();\n                        onRemoveSave(spot);\n                      }}\n                      className=\"p-2.5 rounded-xl bg-stone-800 hover:bg-rose-500/20 text-stone-400 hover:text-rose-400 border border-stone-700 transition-colors\"\n                      title=\"Remove\"\n                    >\n                      <Trash2 className=\"w-3.5 h-3.5\" />\n                    </button>\n                  </div>\n                </div>\n              ))\n            )}\n          </div>\n        </motion.div>\n      </div>\n    </AnimatePresence>\n  );\n};\n"
    }
