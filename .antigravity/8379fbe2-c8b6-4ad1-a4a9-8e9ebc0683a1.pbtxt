    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div\n      ref={cardRef}\n      onMouseMove={handleMouseMove}\n      onMouseLeave={handleMouseLeave}\n      className=\"relative w-full h-[520px] max-w-sm mx-auto perspective-1200 select-none\"\n    >\n      <motion.div\n        style={{\n          rotateX: isFlipped ? 0 : rotateX,\n          rotateY: isFlipped ? 180 : rotateY,\n          transformStyle: \'preserve-3d\',\n        }}\n        animate={{ rotateY: isFlipped ? 180 : 0 }}\n        transition={{ duration: 0.5, ease: [0.23, 1, 0.32, 1] }}\n        className=\"w-full h-full relative rounded-3xl preserve-3d shadow-2xl shadow-black/60 border border-stone-800 bg-stone-900\"\n      >\n        {/* FRONT FACE */}\n        <div\n          className=\"absolute inset-0 w-full h-full rounded-3xl overflow-hidden backface-hidden flex flex-col bg-stone-900 border border-stone-800/80\"\n          style={{ transform: \'rotateY(0deg)\' }}\n        >\n          {/* Dynamic glare shine overlay */}\n          <motion.div\n            style={{ opacity: glareOpacity }}\n            className=\"pointer-events-none absolute inset-0 z-30 bg-gradient-to-tr from-transparent via-white/15 to-transparent mix-blend-overlay\"\n          />\n\n          {/* Top image header with full-bleed aesthetic */}\n          <div className=\"relative h-[290px] w-full shrink-0 overflow-hidden\">\n            <FastImage\n              src={spot.image}\n              alt={spot.name}\n              priority={priority}\n              className=\"w-full h-full object-cover transform hover:scale-105 transition-transform duration-700 ease-out\"\n            />\n            {/* Gradient Scrim */}\n            <div className=\"absolute inset-0 bg-gradient-to-t from-stone-900 via-stone-900/30 to-black/50\" />\n\n            {/* Top Proximity & Distance Bar */}\n            <div className=\"absolute top-3.5 left-3.5 right-3.5 flex items-center justify-between z-20\">\n              <div className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-stone-950/80 backdrop-blur-md border border-amber-500/30 text-amber-300 text-xs font-semibold shadow-lg\">\n                <span className=\"relative flex h-2 w-2\">\n                  <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75\"></span>\n                  <span className=\"relative inline-flex rounded-full h-2 w-2 bg-amber-500\"></span>\n                </span>\n                <span>{spot.distanceMeters}m away</span>\n                <span className=\"text-stone-500\">\342\200\242</span>\n                <span className=\"text-stone-300\">{spot.walkingTimeSeconds}s walk</span>\n              </div>\n\n              <div className=\"flex items-center gap-1.5\">\n                <button\n                  id={`share-btn-${spot.id}`}\n                  onClick={handleShare}\n                  aria-label=\"Share spot\"\n                  className=\"p-2 rounded-full bg-stone-950/70 backdrop-blur-md border border-stone-700/60 text-stone-200 hover:text-white hover:bg-stone-900 active:scale-95 transition-all\"\n                >\n                  <Share2 className=\"w-3.5 h-3.5\" />\n                </button>\n                <button\n                  id={`save-btn-${spot.id}`}\n                  onClick={(e) => {\n                    e.stopPropagation();\n                    sound.playClick();\n                    onToggleSave(spot);\n                  }}\n                  aria-label=\"Save spot\"\n                  className={`p-2 rounded-full backdrop-blur-md border transition-all active:scale-95 ${\n                    isSaved\n                      ? \'bg-rose-500/20 border-rose-500/50 text-rose-400\'\n                      : \'bg-stone-950/70 border-stone-700/60 text-stone-200 hover:text-rose-400\'\n                  }`}\n                >\n                  <Heart className={`w-3.5 h-3.5 ${isSaved ? \'fill-rose-500\' : \'\'}`} />\n                </button>\n              </div>\n            </div>\n\n            {/* Top Deal Banner floating over image */}\n            <div className=\"absolute bottom-3 left-3.5 right-3.5 z-20\">\n              <div className=\"p-2.5 rounded-2xl bg-stone-950/85 backdrop-blur-md border border-amber-500/30 shadow-xl flex items-center justify-between\">\n                <div className=\"flex items-center gap-2 min-w-0\">\n                  <div className=\"w-8 h-8 rounded-xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center shrink-0 text-amber-400\">\n                    <Flame className=\"w-4 h-4\" />\n                  </div>\n                  <div className=\"min-w-0 pr-1\">\n                    <div className=\"text-[11px] font-semibold text-amber-400 uppercase tracking-wide truncate\">\n                      {spot.topDeal.badge}\n                    </div>\n                    <div className=\"text-xs font-bold text-stone-100 truncate\">\n                      {spot.topDeal.item}\n                    </div>\n                  </div>\n                </div>\n                <div className=\"text-right shrink-0 pl-2\">\n                  <span className=\"text-base font-extrabold text-amber-400\">\n                    ${spot.topDeal.price.toFixed(2)}\n                  </span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Lower Card Info Section */}\n          <div className=\"p-4 flex-1 flex flex-col justify-between bg-gradient-to-b from-stone-900 to-stone-950\">\n            <div>\n              {/* Category & Rating */}\n              <div className=\"flex items-center justify-between text-xs text-stone-400 mb-1.5\">\n                <span className=\"px-2 py-0.5 rounded-md bg-stone-800 text-stone-300 font-medium text-[11px]\">\n                  {spot.category}\n                </span>\n                <div className=\"flex items-center gap-1\">\n                  <span className=\"text-amber-400 font-semibold\">\342\230\205 {spot.rating}</span>\n                  <span className=\"text-stone-500\">({spot.reviewCount})</span>\n                </div>\n              </div>\n\n              {/* Spot Name */}\n              <h3 className=\"text-base font-bold text-stone-100 line-clamp-1 leading-snug tracking-tight\">\n                {spot.name}\n              </h3>\n\n              {/* Brief Description */}\n              <p className=\"text-xs text-stone-400 line-clamp-2 mt-1 leading-relaxed\">\n                {spot.description}\n              </p>\n\n              {/* Dietary / Fast Tags */}\n              <div className=\"flex flex-wrap gap-1.5 mt-2.5\">\n                {spot.dietaryTags.slice(0, 2).map((tag) => (\n                  <span\n                    key={tag}\n                    className=\"text-[10px] px-2 py-0.5 rounded-full bg-stone-800/80 border border-stone-700/60 text-stone-300\"\n                  >\n                    {tag}\n                  </span>\n                ))}\n                <button\n                  onClick={toggleFlip}\n                  className=\"text-[10px] px-2 py-0.5 rounded-full bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 flex items-center gap-1 font-medium ml-auto transition-colors\"\n                >\n                  <span>Quick Menu</span>\n                  <RotateCcw className=\"w-2.5 h-2.5\" />\n                </button>\n              </div>\n            </div>\n\n            {/* Quick Actions Footer */}\n            <div className=\"pt-3 border-t border-stone-800/80 flex items-center gap-2 mt-2\">\n              <button\n                id={`details-btn-${spot.id}`}\n                onClick={(e) => {\n                  e.stopPropagation();\n                  sound.playClick();\n                  onOpenDetails(spot);\n                }}\n                className=\"flex-1 py-2.5 px-3 rounded-xl bg-stone-800 hover:bg-stone-750 text-stone-200 text-xs font-semibold flex items-center justify-center gap-1.5 border border-stone-700/60 active:scale-98 transition-all\"\n              >\n                <Info className=\"w-3.5 h-3.5 text-stone-400\" />\n                <span>Full Spot</span>\n              </button>\n\n              <button\n                id={`navigate-btn-${spot.id}`}\n                onClick={(e) => {\n                  e.stopPropagation();\n                  sound.playSuccess();\n                  onNavigate(spot);\n                }}\n                className=\"flex-[1.4] py-2.5 px-3 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-stone-950 text-xs font-bold flex items-center justify-center gap-1.5 shadow-lg shadow-amber-500/20 active:scale-98 transition-all\"\n              >\n                <Navigation className=\"w-3.5 h-3.5 fill-stone-950\" />\n                <span>Walk ({spot.stepsCount} steps)</span>\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* BACK FACE: Quick Menu & Budget Deals */}\n        <div\n          className=\"absolute inset-0 w-full h-full rounded-3xl p-4 bg-stone-900 border border-amber-500/40 backface-hidden flex flex-col justify-between shadow-2xl\"\n          style={{ transform: \'rotateY(180deg)\' }}\n        >\n          <div>\n            {/* Header */}\n            <div className=\"flex items-center justify-between pb-3 border-b border-stone-800\">\n              <div className=\"flex items-center gap-2\">\n                <div className=\"w-7 h-7 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center\">\n                  <Sparkles className=\"w-3.5 h-3.5\" />\n                </div>\n                <div>\n                  <h4 className=\"text-xs font-bold text-stone-100\">Top Cheap Deals</h4>\n                  <p className=\"text-[10px] text-stone-400\">{spot.name}</p>\n                </div>\n              </div>\n              <button\n                onClick={toggleFlip}\n                className=\"p-1.5 rounded-full bg-stone-800 text-stone-300 hover:text-white transition-colors\"\n                aria-label=\"Flip back\"\n              >\n                <RotateCcw className=\"w-3.5 h-3.5\" />\n              </button>\n            </div>\n\n            {/* Menu Items List */}\n            <div className=\"mt-3 space-y-2 max-h-[260px] overflow-y-auto pr-1\">\n              {spot.menu.map((item) => (\n                <div\n                  key={item.id}\n                  className=\"p-2.5 rounded-xl bg-stone-800/60 border border-stone-750 flex items-center justify-between gap-2\"\n                >\n                  <div className=\"min-w-0\">\n                    <div className=\"flex items-center gap-1.5\">\n                      <span className=\"text-xs font-semibold text-stone-200 truncate\">\n                        {item.name}\n                      </span>\n                      {item.isBestseller && (\n                        <span className=\"text-[9px] px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30 font-medium\">\n                          Deal\n                        </span>\n                      )}\n                    </div>\n                    <p className=\"text-[10px] text-stone-400 truncate mt-0.5\">\n                      {item.description}\n                    </p>\n                  </div>\n                  <span className=\"text-xs font-bold text-amber-400 shrink-0\">\n                    ${item.price.toFixed(2)}\n                  </span>\n                </div>\n              ))}\n            </div>\n\n            {/* Secret Hack */}\n            <div className=\"mt-3 p-2.5 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-200 text-[11px] flex items-start gap-2\">\n              <span className=\"font-bold shrink-0\">\360\237\222\241 Pro Tip:</span>\n              <span className=\"text-amber-100/90 text-[10px] leading-tight\">\n                {spot.secretTip}\n              </span>\n            </div>\n          </div>\n\n          {/* Quick Route footer on back */}\n          <div className=\"pt-3 border-t border-stone-800 flex items-center gap-2\">\n            <button\n              onClick={() => {\n                sound.playSuccess();\n                onNavigate(spot);\n              }}\n              className=\"w-full py-2.5 px-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-stone-950 text-xs font-bold flex items-center justify-center gap-2 transition-colors\"\n            >\n              <Navigation className=\"w-3.5 h-3.5 fill-stone-950\" />\n              <span>Head There Now ({spot.distanceMeters}m)</span>\n            </button>\n          </div>\n        </div>\n      </motion.div>\n    </div>\n  );"
        replacement_content: "  return (\n    <div\n      ref={cardRef}\n      onMouseMove={handleMouseMove}\n      onMouseLeave={handleMouseLeave}\n      className=\"relative w-full h-[520px] max-w-sm mx-auto perspective-1200 select-none\"\n    >\n      <motion.div\n        style={{\n          rotateX: isFlipped ? 0 : rotateX,\n          rotateY: isFlipped ? 180 : rotateY,\n          transformStyle: \'preserve-3d\',\n        }}\n        animate={{ rotateY: isFlipped ? 180 : 0 }}\n        transition={{ duration: 0.5, ease: [0.23, 1, 0.32, 1] }}\n        className=\"w-full h-full relative rounded-3xl preserve-3d shadow-2xl shadow-black/80 border border-[#262626] bg-[#121212]\"\n      >\n        {/* FRONT FACE */}\n        <div\n          className=\"absolute inset-0 w-full h-full rounded-3xl overflow-hidden backface-hidden flex flex-col bg-[#121212] border border-[#262626]\"\n          style={{ transform: \'rotateY(0deg)\' }}\n        >\n          {/* Dynamic glare shine overlay */}\n          <motion.div\n            style={{ opacity: glareOpacity }}\n            className=\"pointer-events-none absolute inset-0 z-30 bg-gradient-to-tr from-transparent via-white/10 to-transparent mix-blend-overlay\"\n          />\n\n          {/* Top image header with full-bleed aesthetic */}\n          <div className=\"relative h-[290px] w-full shrink-0 overflow-hidden bg-[#0A0A0A]\">\n            <FastImage\n              src={spot.image}\n              alt={spot.name}\n              priority={priority}\n              className=\"w-full h-full object-cover transform hover:scale-105 transition-transform duration-700 ease-out\"\n            />\n            {/* Gradient Scrim */}\n            <div className=\"absolute inset-0 bg-gradient-to-t from-[#121212] via-[#121212]/30 to-black/60\" />\n\n            {/* Top Proximity & Distance Bar */}\n            <div className=\"absolute top-3.5 left-3.5 right-3.5 flex items-center justify-between z-20\">\n              <div className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#0A0A0A]/90 backdrop-blur-md border border-[#E2FF3B]/40 text-[#E2FF3B] text-xs font-mono font-bold shadow-lg\">\n                <span className=\"relative flex h-2 w-2\">\n                  <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-[#E2FF3B] opacity-75\"></span>\n                  <span className=\"relative inline-flex rounded-full h-2 w-2 bg-[#E2FF3B]\"></span>\n                </span>\n                <span>{spot.distanceMeters}m away</span>\n                <span className=\"text-[#555555]\">\342\200\242</span>\n                <span className=\"text-[#D4D4D8]\">{spot.walkingTimeSeconds}s walk</span>\n              </div>\n\n              <div className=\"flex items-center gap-1.5\">\n                <button\n                  id={`share-btn-${spot.id}`}\n                  onClick={handleShare}\n                  aria-label=\"Share spot\"\n                  className=\"p-2 rounded-full bg-[#0A0A0A]/80 backdrop-blur-md border border-[#333333] text-[#D4D4D8] hover:text-white hover:bg-[#1F1F1F] active:scale-95 transition-all\"\n                >\n                  <Share2 className=\"w-3.5 h-3.5\" />\n                </button>\n                <button\n                  id={`save-btn-${spot.id}`}\n                  onClick={(e) => {\n                    e.stopPropagation();\n                    sound.playClick();\n                    onToggleSave(spot);\n                  }}\n                  aria-label=\"Save spot\"\n                  className={`p-2 rounded-full backdrop-blur-md border transition-all active:scale-95 ${\n                    isSaved\n                      ? \'bg-[#FF5238]/20 border-[#FF5238]/60 text-[#FF5238]\'\n                      : \'bg-[#0A0A0A]/80 border-[#333333] text-[#D4D4D8] hover:text-[#FF5238]\'\n                  }`}\n                >\n                  <Heart className={`w-3.5 h-3.5 ${isSaved ? \'fill-[#FF5238]\' : \'\'}`} />\n                </button>\n              </div>\n            </div>\n\n            {/* Top Deal Banner floating over image */}\n            <div className=\"absolute bottom-3 left-3.5 right-3.5 z-20\">\n              <div className=\"p-2.5 rounded-2xl bg-[#0A0A0A]/90 backdrop-blur-md border border-[#E2FF3B]/35 shadow-xl flex items-center justify-between\">\n                <div className=\"flex items-center gap-2.5 min-w-0\">\n                  <div className=\"w-8 h-8 rounded-xl bg-[#E2FF3B] text-[#0A0A0A] flex items-center justify-center shrink-0 font-black\">\n                    <Flame className=\"w-4 h-4 fill-[#0A0A0A]\" />\n                  </div>\n                  <div className=\"min-w-0 pr-1\">\n                    <div className=\"text-[10px] font-mono font-bold text-[#E2FF3B] uppercase tracking-wider truncate\">\n                      {spot.topDeal.badge}\n                    </div>\n                    <div className=\"text-xs font-bold text-[#F0F0F0] truncate\">\n                      {spot.topDeal.item}\n                    </div>\n                  </div>\n                </div>\n                <div className=\"text-right shrink-0 pl-2\">\n                  <span className=\"text-base font-black text-[#E2FF3B] font-mono\">\n                    ${spot.topDeal.price.toFixed(2)}\n                  </span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Lower Card Info Section */}\n          <div className=\"p-4 flex-1 flex flex-col justify-between bg-gradient-to-b from-[#121212] to-[#0A0A0A]\">\n            <div>\n              {/* Category & Rating */}\n              <div className=\"flex items-center justify-between text-xs text-[#8E8E93] mb-1.5 font-mono\">\n                <span className=\"px-2 py-0.5 rounded-md bg-[#1F1F1F] text-[#D4D4D8] font-medium text-[10px] border border-[#2E2E2E]\">\n                  {spot.category}\n                </span>\n                <div className=\"flex items-center gap-1\">\n                  <span className=\"text-[#E2FF3B] font-bold\">\342\230\205 {spot.rating}</span>\n                  <span className=\"text-[#71717A]\">({spot.reviewCount})</span>\n                </div>\n              </div>\n\n              {/* Spot Name */}\n              <h3 className=\"text-base font-bold text-[#F0F0F0] line-clamp-1 leading-snug tracking-tight font-display\">\n                {spot.name}\n              </h3>\n\n              {/* Brief Description */}\n              <p className=\"text-xs text-[#8E8E93] line-clamp-2 mt-1 leading-relaxed\">\n                {spot.description}\n              </p>\n\n              {/* Dietary / Fast Tags */}\n              <div className=\"flex flex-wrap gap-1.5 mt-2.5\">\n                {spot.dietaryTags.slice(0, 2).map((tag) => (\n                  <span\n                    key={tag}\n                    className=\"text-[10px] font-mono px-2 py-0.5 rounded-full bg-[#1A1A1A] border border-[#2E2E2E] text-[#A1A1AA]\"\n                  >\n                    {tag}\n                  </span>\n                ))}\n                <button\n                  onClick={toggleFlip}\n                  className=\"text-[10px] font-mono px-2 py-0.5 rounded-full bg-[#E2FF3B]/10 hover:bg-[#E2FF3B]/20 text-[#E2FF3B] border border-[#E2FF3B]/30 flex items-center gap-1 font-bold ml-auto transition-colors\"\n                >\n                  <span>Quick Menu</span>\n                  <RotateCcw className=\"w-2.5 h-2.5\" />\n                </button>\n              </div>\n            </div>\n\n            {/* Quick Actions Footer */}\n            <div className=\"pt-3 border-t border-[#222222] flex items-center gap-2 mt-2\">\n              <button\n                id={`details-btn-${spot.id}`}\n                onClick={(e) => {\n                  e.stopPropagation();\n                  sound.playClick();\n                  onOpenDetails(spot);\n                }}\n                className=\"flex-1 py-2.5 px-3 rounded-xl bg-[#1C1C1E] hover:bg-[#262629] text-[#D4D4D8] hover:text-[#F0F0F0] text-xs font-semibold flex items-center justify-center gap-1.5 border border-[#2E2E32] active:scale-98 transition-all\"\n              >\n                <Info className=\"w-3.5 h-3.5 text-[#8E8E93]\" />\n                <span>Full Spot</span>\n              </button>\n\n              <button\n                id={`navigate-btn-${spot.id}`}\n                onClick={(e) => {\n                  e.stopPropagation();\n                  sound.playSuccess();\n                  onNavigate(spot);\n                }}\n                className=\"flex-[1.4] py-2.5 px-3 rounded-xl bg-[#E2FF3B] hover:bg-[#d5f330] text-[#0A0A0A] text-xs font-extrabold flex items-center justify-center gap-1.5 shadow-lg shadow-[#E2FF3B]/20 active:scale-98 transition-all font-display tracking-tight\"\n              >\n                <Navigation className=\"w-3.5 h-3.5 fill-[#0A0A0A]\" />\n                <span>Walk ({spot.stepsCount} steps)</span>\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* BACK FACE: Quick Menu & Budget Deals */}\n        <div\n          className=\"absolute inset-0 w-full h-full rounded-3xl p-4 bg-[#141414] border border-[#E2FF3B]/40 backface-hidden flex flex-col justify-between shadow-2xl\"\n          style={{ transform: \'rotateY(180deg)\' }}\n        >\n          <div>\n            {/* Header */}\n            <div className=\"flex items-center justify-between pb-3 border-b border-[#262626]\">\n              <div className=\"flex items-center gap-2\">\n                <div className=\"w-7 h-7 rounded-lg bg-[#E2FF3B]/20 text-[#E2FF3B] flex items-center justify-center\">\n                  <Sparkles className=\"w-3.5 h-3.5\" />\n                </div>\n                <div>\n                  <h4 className=\"text-xs font-bold text-[#F0F0F0] font-display\">Top Cheap Deals</h4>\n                  <p className=\"text-[10px] text-[#8E8E93] font-mono\">{spot.name}</p>\n                </div>\n              </div>\n              <button\n                onClick={toggleFlip}\n                className=\"p-1.5 rounded-full bg-[#222222] text-[#D4D4D8] hover:text-white transition-colors\"\n                aria-label=\"Flip back\"\n              >\n                <RotateCcw className=\"w-3.5 h-3.5\" />\n              </button>\n            </div>\n\n            {/* Menu Items List */}\n            <div className=\"mt-3 space-y-2 max-h-[260px] overflow-y-auto pr-1\">\n              {spot.menu.map((item) => (\n                <div\n                  key={item.id}\n                  className=\"p-2.5 rounded-xl bg-[#1C1C1E] border border-[#2E2E32] flex items-center justify-between gap-2\"\n                >\n                  <div className=\"min-w-0\">\n                    <div className=\"flex items-center gap-1.5\">\n                      <span className=\"text-xs font-semibold text-[#F0F0F0] truncate\">\n                        {item.name}\n                      </span>\n                      {item.isBestseller && (\n                        <span className=\"text-[9px] font-mono px-1.5 py-0.2 rounded bg-[#E2FF3B]/20 text-[#E2FF3B] border border-[#E2FF3B]/40 font-bold\">\n                          DEAL\n                        </span>\n                      )}\n                    </div>\n                    <p className=\"text-[10px] text-[#8E8E93] truncate mt-0.5\">\n                      {item.description}\n                    </p>\n                  </div>\n                  <span className=\"text-xs font-black text-[#E2FF3B] shrink-0 font-mono\">\n                    ${item.price.toFixed(2)}\n                  </span>\n                </div>\n              ))}\n            </div>\n\n            {/* Secret Hack */}\n            <div className=\"mt-3 p-2.5 rounded-xl bg-[#E2FF3B]/10 border border-[#E2FF3B]/30 text-[#E2FF3B] text-[11px] flex items-start gap-2\">\n              <span className=\"font-bold shrink-0 font-mono\">\360\237\222\241 PRO TIP:</span>\n              <span className=\"text-[#D4D4D8] text-[10px] leading-tight font-sans\">\n                {spot.secretTip}\n              </span>\n            </div>\n          </div>\n\n          {/* Quick Route footer on back */}\n          <div className=\"pt-3 border-t border-[#262626] flex items-center gap-2\">\n            <button\n              onClick={() => {\n                sound.playSuccess();\n                onNavigate(spot);\n              }}\n              className=\"w-full py-2.5 px-3 rounded-xl bg-[#E2FF3B] hover:bg-[#d5f330] text-[#0A0A0A] text-xs font-extrabold flex items-center justify-center gap-2 transition-colors font-display tracking-tight\"\n            >\n              <Navigation className=\"w-3.5 h-3.5 fill-[#0A0A0A]\" />\n              <span>Head There Now ({spot.distanceMeters}m)</span>\n            </button>\n          </div>\n        </div>\n      </motion.div>\n    </div>\n  );"
