er gap-1 mt-1\">\n                <MapPin className=\"w-3.5 h-3.5 text-stone-500\" />\n                <span>{spot.address}</span>\n              </p>\n            </div>\n\n            {/* Top Deal Highlight */}\n            <div className=\"p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-between\">\n              <div className=\"flex items-center gap-2.5\">\n                <div className=\"w-9 h-9 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center\">\n                  <Flame className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <div className=\"text-[11px] font-bold text-amber-400 uppercase tracking-wide\">\n                    {spot.topDeal.badge}\n                  </div>\n                  <div className=\"text-xs font-bold text-stone-100\">\n                    {spot.topDeal.item}\n                  </div>\n                </div>\n              </div>\n              <div className=\"text-right\">\n                <span className=\"text-lg font-black text-amber-400\">\n                  ${spot.topDeal.price.toFixed(2)}\n                </span>\n              </div>\n            </div>\n\n            {/* Description & Secret Pro Tip */}\n            <div>\n              <h4 className=\"text-xs font-bold text-stone-300 uppercase tracking-wider mb-1.5\">\n                About this Spot\n              </h4>\n              <p className=\"text-xs text-stone-300 leading-relaxed\">\n                {spot.description}\n              </p>\n\n              <div className=\"mt-2.5 p-3 rounded-xl bg-stone-800/80 border border-stone-700/60 text-xs text-stone-300 flex items-start gap-2\">\n                <Sparkles className=\"w-4 h-4 text-amber-400 shrink-0 mt-0.5\" />\n                <div>\n                  <span className=\"font-bold text-amber-300\">Local Hack: </span>\n                  <span>{spot.secretTip}</span>\n                </div>\n              </div>\n    