rue }\n    ],\n    photos: [\n      \'https://images.unsplash.com/photo-1541696432-82c6da8ce7bf?auto=format&fit=crop&w=1200&q=85\',\n      \'https://images.unsplash.com/photo-1563245372-f21724e3856d?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1498654896293-37aacf113fd9?auto=format&fit=crop&w=1000&q=80\'\n    ]\n  },\n  {\n    id: \'spot-2\',\n    name: \'Taqueria El Sol Midnight Cart\',\n    category: \'Taco Stand\',\n    image: \'https://images.unsplash.com/photo-1551504734-5ee1c4a1479b?auto=format&fit=crop&w=1200&q=85\',\n    thumbnail: \'https://images.unsplash.com/photo-1551504734-5ee1c4a1479b?auto=format&fit=crop&w=300&q=70\',\n    rating: 4.8,\n    reviewCount: 612,\n    priceRange: \'$\',\n    topDeal: {\n      item: \'Street Taco with Charred Lime & Salsa\',\n      price: 2.75,\n      badge: \'Unbeatable $2.75 Deal\'\n    },\n    distanceMeters: 58,\n    walkingTimeSeconds: 45,\n    stepsCount: 76,\n    bearingDegrees: 110,\n    address: \'Directly in front of the Metro Plaza\',\n    openingHours: \'11:00 AM \342\200\223 2:00 AM\',\n    isOpenNow: true,\n    dietaryTags: [\'Gluten-Free Tortillas\', \'Halal Beef\', \'Veggie Option\'],\n    paymentTypes: [\'Cash\', \'Apple Pay\', \'Venmo\'],\n    description: \'Sizzling flat-top griddle tacos served on double warm corn tortillas with freshly chopped cilantro, white onion, and three homemade fiery salsas.\',\n    secretTip: \'Ask for \"con todo y pi\303\261a\" (with everything and roasted pineapple) on the al pastor.\',\n    menu: [\n      { id: \'t1\', name: \'Al Pastor Street Taco\', price: 2.75, description: \'Spit-roasted marinated pork with caramelized pineapple and cilantro\', isBestseller: true },\n      { id: \'t2\', name: \'Crispy Suadero Beef Taco\', price: 2.95, description: \'Slow-confit beef brisket crisped to order on the comal\', isBestseller: true, isGlutenFree: true },\n      { id: \'t3\', name: \'Grilled Nopal (Cactus) & Queso Taco\', price: 2.50, description: \'Tender cactus paddle with seared panela cheese\', isVegetarian: true, isGlutenFree: true },\n      { id: \'t4\', name: \'Fresh Horchata de Arroz (16oz)\', price: 2.00, description: \'House-made cinnamon rice milk, chilled and refreshing\', isVegetarian: true }\n    ],\n    photos: [\n      \'https://images.unsplash.com/photo-1551504734-5ee1c4a1479b?auto=format&fit=crop&w=1200&q=85\',\n      \'https://images.unsplash.com/photo-1565299585323-38d6b0865b47?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=1000&q=80\'\n    ]\n  },\n  {\n    id: \'spot-3\',\n    name: \'Habibi Crisp Falafel & Pita Pocket\',\n    category: \'Falafel & Kebab\',\n    image: \'https://images.unsplash.com/photo-1593001874117-c99c800e3eb7?auto=format&fit=crop&w=1200&q=85\',\n    thumbnail: \'https://images.unsplash.com/photo-1593001874117-c99c800e3eb7?auto=format&fit=crop&w=300&q=70\',\n    rating: 4.9,\n    reviewCount: 389,\n    priceRange: \'$\',\n    topDeal: {\n      item: \'Jumbo Falafel Pocket + Lemon Tahini\',\n      price: 4.90,\n      badge: \'Full Meal for $4.90\'\n    },\n    distanceMeters: 67,\n    walkingTimeSeconds: 50,\n    stepsCount: 88,\n    bearingDegrees: 280,\n    address: \'Alleyway Entrance next to the Clocktower\',\n    openingHours: \'10:00 AM \342\200\223 10:00 PM\',\n    isOpenNow: true,\n    dietaryTags: [\'100% Vegan\', \'100% Halal\', \'Dairy-Free\'],\n    paymentTypes: [\'Cash\', \'Card\', \'Apple Pay\'],\n    description: \'Hot chickpea falafel patties fried crisp in fresh sunflower oil, stuffed into warm pocket pita with tangy pickled red cabbage and lemon-garlic tahini.\',\n    secretTip: \'They give you a free steaming falafel ball while you wait in line!\',\n    menu: [\n      { id: \'f1\', name: \'Classic Golden Falafel Pita\', price: 4.90, description: \'4 falafel balls, hummus, cucumber salad, pickled turnips, tahini\', isBestseller: true, isVegetarian: true, isHalal: true },\n      { id: \'f2\', name: \'Spicy Shatta Falafel Pocket\', price: 5.25, description: \'Infused with house red pepper chili paste and sumac onions\', isVegetarian: true, isHalal: true },\n      { id: \'f3\', name: \'Side of 5 Falafels with Tahini\', price: 3.50, description: \'Crunchy golden orbs with herbs and sesame seeds\', isVegetarian: true, isHalal: true },\n      { id: \'f4\', name: \'Mint Lemonade Spritz\', price: 2.25, description: \'Fresh squeezed lemon juice crushed with fresh mint leaves\', isVegetarian: true }\n    ],\n    photos: [\n      \'https://images.unsplash.com/photo-1593001874117-c99c800e3eb7?auto=format&fit=crop&w=1200&q=85\',\n      \'https://images.unsplash.com/photo-1540420773420-3366772f4999?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1529006557810-274b9b2fc783?auto=format&fit=crop&w=1000&q=80\'\n    ]\n  },\n  {\n    id: \'spot-4\',\n    name: \'Saigon Street 89 Banh Mi Hole-in-the-Wall\',\n    category: \'Window Deli\',\n    image: \'https://images.unsplash.com/photo-1626804475297-41608ea09aeb?auto=format&fit=crop&w=1200&q=85\',\n    thumbnail: \'https://images.unsplash.com/photo-1626804475297-41608ea09aeb?auto=format&fit=crop&w=300&q=70\',\n    rating: 4.9,\n    reviewCount: 540,\n    priceRange: \'$\',\n    topDeal: {\n      item: \'Lemongrass Pork Banh Mi\',\n      price: 4.50,\n      badge: \'Legendary Crunch $4.50\'\n    },\n    distanceMeters: 74,\n    walkingTimeSeconds: 58,\n    stepsCount: 96,\n    bearingDegrees: 195,\n    address: \'89 Maple Street (Look for yellow lantern)\',\n    openingHours: \'9:00 AM \342\200\223 8:30 PM\',\n    isOpenNow: true,\n    dietaryTags: [\'Pork\', \'Tofu Option\', \'Vietnamese Coffee\'],\n    paymentTypes: [\'Cash\', \'Card\', \'Apple Pay\'],\n    description: \'Crisp, airy baguette with house liver p\303\242t\303\251, savory caramelized pork or five-spice tofu, pickled daikon & carrots, fresh cilantro, and birds eye chilies.\',\n    secretTip: \'Add an over-easy fried egg inside the sandwich for just $1 extra.\',\n    menu: [\n      { id: \'b1\', name: \'Classic Lemongrass Pork Banh Mi\', price: 4.50, description: \'Char-grilled lemongrass pork, cucumber, pickled veggies, pate, jalape\303\261o\', isBestseller: true },\n      { id: \'b2\', name: \'Crispy Lemongrass Tofu Banh Mi\', price: 4.25, description: \'Golden braised tofu with vegan mayonnaise and fresh herbs\', isVegetarian: true, isBestseller: true },\n      { id: \'b3\', name: \'Traditional Vietnamese Iced Coffee (Ca Phe Sua Da)\', price: 3.00, description: \'Slow-drip dark roast with sweetened condensed milk over crushed ice\' },\n      { id: \'b4\', name: \'Fried Spring Rolls (2 rolls)\', price: 2.75, description: \'Crispy rice paper rolls stuffed with glass noodles and wood-ear mushrooms\' }\n    ],\n    photos: [\n      \'https://images.unsplash.com/photo-1626804475297-41608ea09aeb?auto=format&fit=crop&w=1200&q=85\',\n      \'https://images.unsplash.com/photo-1582878826629-29b7ad1cdc43?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=1000&q=80\'\n    ]\n  },\n  {\n    id: \'spot-5\',\n    name: \'Nonna Lucia 99\302\242 Pizza Slice Corner\',\n    category: \'Pizzeria Slice\',\n    image: \'https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=1200&q=85\',\n    thumbnail: \'https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=300&q=70\',\n    rating: 4.7,\n    reviewCount: 884,\n    priceRange: \'$\',\n    topDeal: {\n      item: \'2 Giant Cheese Slices + Cold Soda Can\',\n      price: 3.50,\n      badge: \'2 Slices + Drink $3.50\'\n    },\n    distanceMeters: 81,\n    walkingTimeSeconds: 65,\n    stepsCount: 105,\n    bearingDegrees: 340,\n    address: \'East Broad & 3rd Avenue\',\n    openingHours: \'10:00 AM \342\200\223 3:30 AM\',\n    isOpenNow: true,\n    dietaryTags: [\'Vegetarian Friendly\', \'Late Night\', \'Quick Grab\'],\n    paymentTypes: [\'Cash\', \'Card\'],\n    description: \'Foldable, super crispy thin-crust slices fresh out of a 600\302\260F deck oven with sweet San Marzano tomato sauce and stringy whole milk mozzarella.\',\n    secretTip: \'Sprinkle their house-blended garlic herb oil and crushed red pepper on the crust!\',\n    menu: [\n      { id: \'p1\', name: \'Classic NY Cheese Slice\', price: 1.50, description: \'Thin, crisp crust with bubbling mozzarella and oregano tomato sauce\', isVegetarian: true, isBestseller: true },\n      { id: \'p2\', name: \'Crispy Pepperoni Slice\', price: 2.25, description: \'Loaded with charred cupping pepperonis that crisp up in the oven\', isBestseller: true },\n      { id: \'p3\', name: \'Garlic Knots (4pcs) with Marinara Cup\', price: 2.00, description: \'Pillowy dough knots rolled in parsley, garlic butter, and parmesan\', isVegetarian: true },\n      { id: \'p4\', name: \'Grandma Square Sicilian Slice\', price: 2.50, description: \'Thick focaccia crust with sweet plum tomatoes and fresh basil\', isVegetarian: true }\n    ],\n    photos: [\n      \'https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=1200&q=85\',\n      \'https://images.unsplash.com/photo-1574071318508-1cdbab80d002?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1534308983496-4fabb1a015ee?auto=format&fit=crop&w=1000&q=80\'\n    ]\n  },\n  {\n    id: \'spot-6\',\n    name: \'Bangkok Night Market Pad Thai Cart\',\n    category: \'Noodle Stall\',\n    image: \'https://images.unsplash.com/photo-1559847844-5315695dadae?auto=format&fit=crop&w=1200&q=85\',\n    thumbnail: \'https://images.unsplash.com/photo-1559847844-5315695dadae?auto=format&fit=crop&w=300&q=70\',\n    rating: 4.8,\n    reviewCount: 315,\n    priceRange: \'$\',\n    topDeal: {\n      item: \'Wok-Fired Pad Thai with Egg & Peanuts\',\n      price: 4.95,\n      badge: \'Hot Wok Fire $4.95\'\n    },\n    distanceMeters: 88,\n    walkingTimeSeconds: 70,\n    stepsCount: 114,\n    bearingDegrees: 155,\n    address: \'Across from the park fountain, blue canopy\',\n    openingHours: \'11:30 AM \342\200\223 10:00 PM\',\n    isOpenNow: true,\n    dietaryTags: [\'Gluten-Free Rice Noodles\', \'Vegan Available\', \'Halal Chicken\'],\n    paymentTypes: [\'Cash\', \'Card\', \'Apple Pay\', \'Venmo\'],\n    description: \'High-heat wok noodles with tamarind reduction sauce, scrambled egg, beansprouts, crushed roasted peanuts, and fresh lime wedge.\',\n    secretTip: \'Ask for level 2 chili if you like pleasant heat without overpowering the tamarind sweetness.\',\n    menu: [\n      { id: \'n1\', name: \'Classic Street Pad Thai\', price: 4.95, description: \'Rice noodles, egg, tofu, bean sprouts, chives, crushed peanuts, tamarind sauce\', isBestseller: true },\n      { id: \'n2\', name: \'Drunken Spicy Basil Noodles (Pad Kee Mao)\', price: 5.50, description: \'Flat rice noodles with Thai holy basil, bell peppers, and chili paste\', isBestseller: true },\n      { id: \'n3\', name: \'Crispy Veggie Spring Rolls (3pcs)\', price: 3.00, description: \'Served with sweet and sour plum dipping sauce\', isVegetarian: true },\n      { id: \'n4\', name: \'Thai Iced Tea with Cream\', price: 2.50, description: \'Spiced black tea with aromatic star anise and sweetened evaporated milk\', isVegetarian: true }\n    ],\n    photos: [\n      \'https://images.unsplash.com/photo-1559847844-5315695dadae?auto=format&fit=crop&w=1200&q=85\',\n      \'https://images.unsplash.com/photo-1569718212165-3a8278d5f624?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1512058564366-18510be2db19?auto=format&fit=crop&w=1000&q=80\'\n    ]\n  },\n  {\n    id: \'spot-7\',\n    name: \'Old Village Warm Bakery & Espresso\',\n    category: \'Bakery & Cafe\',\n    image: \'https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=1200&q=85\',\n    thumbnail: \'https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=300&q=70\',\n    rating: 4.9,\n    reviewCount: 472,\n    priceRange: \'$\',\n    topDeal: {\n      item: \'Flaky Butter Croissant + Double Espresso\',\n      price: 3.25,\n      badge: \'Morning Fuel $3.25\'\n    },\n    distanceMeters: 92,\n    walkingTimeSeconds: 75,\n    stepsCount: 120,\n    bearingDegrees: 220,\n    address: \'77 Commerce Lane (Green brick building)\',\n    openingHours: \'6:30 AM \342\200\223 5:00 PM\',\n    isOpenNow: true,\n    dietaryTags: [\'Vegetarian\', \'Oat Milk Option\', \'Fresh Baked\'],\n    paymentTypes: [\'Cash\', \'Card\', \'Apple Pay\'],\n    description: \'Artisan sourdough pastries baked fresh every morning from 5 AM using French cultured butter and locally milled organic flours.\',\n    secretTip: \'Warm croissants come out of the oven at 7:30 AM, 11:00 AM, and 2:00 PM daily.\',\n    menu: [\n      { id: \'c1\', name: \'Golden Honey Butter Croissant\', price: 2.25, description: \'72-layer laminated pastry, crispy exterior, cloud-like center\', isBestseller: true, isVegetarian: true },\n      { id: \'c2\', name: \'Pain au Chocolat (Dark Belgian)\', price: 2.75, description: \'Folded with double 70% dark Belgian chocolate batons\', isVegetarian: true },\n      { id: \'c3\', name: \'Spinach & Feta Warm Puff Pastry\', price: 3.50, description: \'Flaky savory pocket with Greek feta, dill, and baby spinach\', isVegetarian: true, isBestseller: true },\n      { id: \'c4\', name: \'Cortado / Double Espresso\', price: 2.50, description: \'Single origin medium-dark roast with silky microfoam\' }\n    ],\n    photos: [\n      \'https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=1200&q=85\',\n      \'https://images.unsplash.com/photo-1555507036-ab1f4038808a?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1517433670267-08bbd4be890f?auto=format&fit=crop&w=1000&q=80\'\n    ]\n  },\n  {\n    id: \'spot-8\',\n    name: \'Lil Smashie Double Cheeseburger Window\',\n    category: \'Window Deli\',\n    image: \'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=1200&q=85\',\n    thumbnail: \'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=300&q=70\',\n    rating: 4.8,\n    reviewCount: 720,\n    priceRange: \'$\',\n    topDeal: {\n      item: \'Single Crispy Edge Smash + Secret Sauce\',\n      price: 3.99,\n      badge: \'Lacey Edge Smash $3.99\'\n    },\n    distanceMeters: 96,\n    walkingTimeSeconds: 80,\n    stepsCount: 126,\n    bearingDegrees: 60,\n    address: \'Side window alley between 2nd & 3rd\',\n    openingHours: \'11:00 AM \342\200\223 Midnight\',\n    isOpenNow: true,\n    dietaryTags: [\'Halal Certified Beef\', \'Gluten-Free Lettuce Wrap\'],\n    paymentTypes: [\'Cash\', \'Card\', \'Apple Pay\'],\n    description: \'Fresh ground chuck pressed paper-thin on a screaming hot chrome flattop for ultra-crispy caramelized lacy edges, melted American cheese, and dill pickles.\',\n    secretTip: \'Ask for grilled onions cooked directly smashed into the meat patty!\',\n    menu: [\n      { id: \'s1\', name: \'Lacey Edge Single Smash\', price: 3.99, description: \'1/4lb smashed patty, American cheese, house pickle chips, smash sauce on toasted potato bun\', isBestseller: true, isHalal: true },\n      { id: \'s2\', name: \'Double Stack Oklahoma Onion Smash\', price: 5.75, description: \'Two patties smashed with paper-thin sweet onions, double cheese\', isBestseller: true, isHalal: true },\n      { id: \'s3\', name: \'Shoestring Seasoned Fries\', price: 2.50, description: \'Golden crispy thin fries with cajun sea salt\', isVegetarian: true },\n      { id: \'s4\', name: \'Old Fashioned Malted Vanilla Shake\', price: 3.25, description: \'Hand-spun real ice cream milkshake with malt powder\', isVegetarian: true }\n    ],\n    photos: [\n      \'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=1200&q=85\',\n      \'https://images.unsplash.com/photo-1550547660-d9450f859349?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1586190848861-99aa4a171e90?auto=format&fit=crop&w=1000&q=80\'\n    ]\n  }\n];\n"
