    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { RadiusFilter, PriceFilter, ViewMode, CityRegion } from \'../types\';\nimport { Layers, Grid, Compass, Volume2, VolumeX, Flame, SlidersHorizontal, Search, MapPin } from \'lucide-react\';\nimport { sound } from \'../utils/audioFeedback\';\n\ninterface FiltersBarProps {\n  cityRegion: CityRegion;\n  setCityRegion: (r: CityRegion) => void;\n  radius: RadiusFilter;\n  setRadius: (r: RadiusFilter) => void;\n  priceFilter: PriceFilter;\n  setPriceFilter: (p: PriceFilter) => void;\n  viewMode: ViewMode;\n  setViewMode: (v: ViewMode) => void;\n  selectedCategory: string;\n  setSelectedCategory: (cat: string) => void;\n  searchQuery: string;\n  setSearchQuery: (q: string) => void;\n  soundEnabled: boolean;\n  setSoundEnabled: (enabled: boolean) => void;\n  totalCount: number;\n}\n\nconst CATEGORIES = [\n  \'All\',\n  \'Vada Pav & Chaat\',\n  \'Dosa & Tiffins\',\n  \'Pav Bhaji & Griddle\',\n  \'Filter Coffee & Chai\',\n  \'Parotta & Biryani\',\n  \'Sandwiches & Frankies\',\n  \'Desserts & Drinks\',\n];\n\nexport const FiltersBar: React.FC<FiltersBarProps> = ({\n  cityRegion,\n  setCityRegion,\n  radius,\n  setRadius,\n  priceFilter,\n  setPriceFilter,\n  viewMode,\n  setViewMode,\n  selectedCategory,\n  setSelectedCategory,\n  searchQuery,\n  setSearchQuery,\n  soundEnabled,\n  setSoundEnabled,\n  totalCount,\n}) => {\n  const handleRegionChange = (newRegion: CityRegion) => {\n    sound.playClick();\n    setCityRegion(newRegion);\n  };\n\n  const handleRadiusChange = (newRadius: RadiusFilter) => {\n    sound.playClick();\n    setRadius(newRadius);\n  };\n\n  const handlePriceChange = (newPrice: PriceFilter) => {\n    sound.playClick();\n    setPriceFilter(newPrice);\n  };\n\n  const handleViewChange = (newView: ViewMode) => {\n    sound.playClick();\n    setViewMode(newView);\n  };\n\n  const toggleSound = () => {\n    const next = !soundEnabled;\n    sound.soundEnabled = next;\n    setSoundEnabled(next);\n    if (next) sound.playClick();\n  };\n\n  return (\n    <div className=\"w-full max-w-4xl mx-auto space-y-3.5 mb-6\">\n      {/* Regional Selector & Radius & View Switcher */}\n      <div className=\"flex flex-wrap items-center justify-between gap-3\">\n        {/* City / State Region Selector */}\n        <div className=\"flex items-center gap-1 p-1 rounded-2xl bg-[#141414] border border-[#262626] shadow-inner\">\n          <span className=\"text-[10px] font-mono font-bold text-[#8E8E93] uppercase tracking-wider pl-2 pr-1 flex items-center gap-1\">\n            <MapPin className=\"w-3 h-3 text-[#E2FF3B]\" />\n            <span className=\"hidden xs:inline\">Region:</span>\n          </span>\n          <button\n            id=\"region-filter-all\"\n            onClick={() => handleRegionChange(\'all\')}\n            className={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all ${\n              cityRegion === \'all\'\n                ? \'bg-[#E2FF3B] text-[#0A0A0A] shadow-md shadow-[#E2FF3B]/20\'\n                : \'text-[#8E8E93] hover:text-[#F0F0F0] hover:bg-[#1F1F1F]\'\n            }`}\n          >\n            All India\n          </button>\n          <button\n            id=\"region-filter-mumbai\"\n            onClick={() => handleRegionChange(\'mumbai\')}\n            className={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all flex items-center gap-1 ${\n              cityRegion === \'mumbai\'\n                ? \'bg-[#E2FF3B] text-[#0A0A0A] shadow-md shadow-[#E2FF3B]/20\'\n                : \'text-[#8E8E93] hover:text-[#F0F0F0] hover:bg-[#1F1F1F]\'\n            }`}\n          >\n            <span>Mumbai (MH)</span>\n          </button>\n          <button\n            id=\"region-filter-tamilnadu\"\n            onClick={() => handleRegionChange(\'tamilnadu\')}\n            className={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all flex items-center gap-1 ${\n              cityRegion === \'tamilnadu\'\n                ? \'bg-[#E2FF3B] text-[#0A0A0A] shadow-md shadow-[#E2FF3B]/20\'\n                : \'text-[#8E8E93] hover:text-[#F0F0F0] hover:bg-[#1F1F1F]\'\n            }`}\n          >\n            <span>Tamil Nadu (TN)</span>\n          </button>\n        </div>\n\n        {/* View Mode Switcher: 3D Swipe Deck vs 3D Grid vs Radar */}\n        <div className=\"flex items-center gap-1 p-1 rounded-2xl bg-[#141414] border border-[#262626] shadow-inner\">\n          <button\n            id=\"view-deck-btn\"\n            onClick={() => handleViewChange(\'deck\')}\n            aria-label=\"3D Swipe Deck View\"\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all ${\n              viewMode === \'deck\'\n                ? \'bg-[#222222] text-[#E2FF3B] border border-[#E2FF3B]/30 shadow\'\n                : \'text-[#8E8E93] hover:text-[#F0F0F0]\'\n            }`}\n          >\n            <Layers className=\"w-3.5 h-3.5\" />\n            <span className=\"hidden sm:inline\">3D Deck</span>\n          </button>\n\n          <button\n            id=\"view-grid-btn\"\n            onClick={() => handleViewChange(\'grid\')}\n            aria-label=\"3D Tilt Grid View\"\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all ${\n              viewMode === \'grid\'\n                ? \'bg-[#222222] text-[#E2FF3B] border border-[#E2FF3B]/30 shadow\'\n                : \'text-[#8E8E93] hover:text-[#F0F0F0]\'\n            }`}\n          >\n            <Grid className=\"w-3.5 h-3.5\" />\n            <span className=\"hidden sm:inline\">3D Grid</span>\n          </button>\n\n          <button\n            id=\"view-radar-btn\"\n            onClick={() => handleViewChange(\'radar\')}\n            aria-label=\"Proximity Radar View\"\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all ${\n              viewMode === \'radar\'\n                ? \'bg-[#222222] text-[#E2FF3B] border border-[#E2FF3B]/30 shadow\'\n                : \'text-[#8E8E93] hover:text-[#F0F0F0]\'\n            }`}\n          >\n            <Compass className=\"w-3.5 h-3.5\" />\n            <span className=\"hidden sm:inline\">Radar</span>\n          </button>\n\n          {/* Sound Toggle */}\n          <button\n            onClick={toggleSound}\n            aria-label={soundEnabled ? \'Mute haptics\' : \'Enable haptics\'}\n            className=\"p-1.5 rounded-xl text-[#8E8E93] hover:text-[#E2FF3B] hover:bg-[#1F1F1F] transition-colors ml-1\"\n          >\n            {soundEnabled ? <Volume2 className=\"w-3.5 h-3.5\" /> : <VolumeX className=\"w-3.5 h-3.5 opacity-40\" />}\n          </button>\n        </div>\n      </div>\n\n      {/* Second Row: Radius Selector & Price Threshold Chips & Search Input */}\n      <div className=\"flex flex-wrap sm:flex-nowrap items-center justify-between gap-3\">\n        {/* Radius Segmented Control (50m - 100m) & Price Chips */}\n        <div className=\"flex flex-wrap items-center gap-2\">\n          {/* Radius */}\n          <div className=\"flex items-center gap-1 p-0.5 rounded-xl bg-[#141414] border border-[#262626]\">\n            {([50, 75, 100] as RadiusFilter[]).map((r) => (\n              <button\n                key={r}\n                id={`radius-filter-${r}`}\n                onClick={() => handleRadiusChange(r)}\n                className={`px-2.5 py-1 rounded-lg text-[11px] font-mono font-bold transition-all ${\n                  radius === r\n                    ? \'bg-[#E2FF3B] text-[#0A0A0A]\'\n                    : \'text-[#8E8E93] hover:text-[#F0F0F0]\'\n                }`}\n              >\n                {r}m\n              </button>\n            ))}\n          </div>\n\n          {/* Price filters in INR */}\n          <div className=\"flex items-center gap-1.5 overflow-x-auto no-scrollbar shrink-0\">\n            {[\n              { key: \'all\', label: \'All Deals\' },\n              { key: \'under50\', label: \'Under \342\202\27150\' },\n              { key: \'under100\', label: \'Under \342\202\271100\' },\n              { key: \'under150\', label: \'Under \342\202\271150\' },\n            ].map((item) => (\n              <button\n                key={item.key}\n                id={`price-filter-${item.key}`}\n                onClick={() => handlePriceChange(item.key as PriceFilter)}\n                className={`px-3 py-1 rounded-full text-xs font-medium font-mono transition-all ${\n                  priceFilter === item.key\n                    ? \'bg-[#E2FF3B]/20 text-[#E2FF3B] border border-[#E2FF3B]/40 font-bold\'\n                    : \'bg-[#141414] border border-[#262626] text-[#A1A1AA] hover:text-[#F0F0F0] hover:border-[#383838]\'\n                }`}\n              >\n                {item.label}\n              </button>\n            ))}\n          </div>\n        </div>\n\n        {/* Count badge & Search */}\n        <div className=\"flex items-center gap-2 w-full sm:w-auto justify-between sm:justify-end\">\n          <div className=\"relative flex-1 sm:w-48\">\n            <Search className=\"w-3.5 h-3.5 absolute left-2.5 top-1/2 -translate-y-1/2 text-[#71717A]\" />\n            <input\n              type=\"text\"\n              placeholder=\"Search spots, vadapav, dosa...\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              className=\"w-full pl-8 pr-3 py-1.5 text-xs rounded-xl bg-[#141414] border border-[#262626] text-[#F0F0F0] placeholder-[#71717A] focus:outline-none focus:border-[#E2FF3B]/50\"\n            />\n          </div>\n          <div className=\"shrink-0 text-xs text-[#8E8E93] font-mono\">\n            <span className=\"text-[#E2FF3B] font-bold\">{totalCount}</span> spots\n          </div>\n        </div>\n      </div>\n\n      {/* Horizontal Category Scroll */}\n      <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1 no-scrollbar\">\n        {CATEGORIES.map((cat) => (\n          <button\n            key={cat}\n            onClick={() => {\n              sound.playClick();\n              setSelectedCategory(cat);\n            }}\n            className={`px-3 py-1 rounded-lg text-[11px] whitespace-nowrap transition-all font-medium ${\n              selectedCategory === cat\n                ? \'bg-[#262626] text-[#E2FF3B] font-bold border border-[#E2FF3B]/30\'\n                : \'text-[#8E8E93] hover:text-[#D4D4D8] bg-[#111111]/60 border border-[#202020]\'\n            }`}\n          >\n            {cat}\n          </button>\n        ))}\n      </div>\n    </div>\n  );\n};\n"
    }
