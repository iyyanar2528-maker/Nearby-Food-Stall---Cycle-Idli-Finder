  file_change {
    absolute_path_uri: "file:///src/components/FiltersBar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { RadiusFilter, PriceFilter, ViewMode } from \'../types\';\nimport { Layers, Grid, Compass, Volume2, VolumeX, Flame, SlidersHorizontal, Search } from \'lucide-react\';\nimport { sound } from \'../utils/audioFeedback\';\n\ninterface FiltersBarProps {\n  radius: RadiusFilter;\n  setRadius: (r: RadiusFilter) => void;\n  priceFilter: PriceFilter;\n  setPriceFilter: (p: PriceFilter) => void;\n  viewMode: ViewMode;\n  setViewMode: (v: ViewMode) => void;\n  selectedCategory: string;\n  setSelectedCategory: (cat: string) => void;\n  searchQuery: string;\n  setSearchQuery: (q: string) => void;\n  soundEnabled: boolean;\n  setSoundEnabled: (enabled: boolean) => void;\n  totalCount: number;\n}\n\nconst CATEGORIES = [\n  \'All\',\n  \'Bao & Dim Sum\',\n  \'Taco Stand\',\n  \'Falafel & Kebab\',\n  \'Window Deli\',\n  \'Pizzeria Slice\',\n  \'Noodle Stall\',\n  \'Bakery & Cafe\',\n];\n\nexport const FiltersBar: React.FC<FiltersBarProps> = ({\n  radius,\n  setRadius,\n  priceFilter,\n  setPriceFilter,\n  viewMode,\n  setViewMode,\n  selectedCategory,\n  setSelectedCategory,\n  searchQuery,\n  setSearchQuery,\n  soundEnabled,\n  setSoundEnabled,\n  totalCount,\n}) => {\n  const handleRadiusChange = (newRadius: RadiusFilter) => {\n    sound.playClick();\n    setRadius(newRadius);\n  };\n\n  const handlePriceChange = (newPrice: PriceFilter) => {\n    sound.playClick();\n    setPriceFilter(newPrice);\n  };\n\n  const handleViewChange = (newView: ViewMode) => {\n    sound.playClick();\n    setViewMode(newView);\n  };\n\n  const toggleSound = () => {\n    const next = !soundEnabled;\n    sound.soundEnabled = next;\n    setSoundEnabled(next);\n    if (next) sound.playClick();\n  };\n\n  return (\n    <div className=\"w-full max-w-4xl mx-auto space-y-3.5 mb-6\">\n      {/* Top Bar: Radius Pill Selector & View Modes & Sound Toggle */}\n      <div className=\"flex flex-wrap items-center justify-between gap-3\">\n        {/* Radius Segmented Control (50m - 100m) */}\n        <div className=\"flex items-center gap-1.5 p-1 rounded-2xl bg-stone-900 border border-stone-800 shadow-inner\">\n          <span className=\"text-[10px] font-bold text-stone-400 uppercase tracking-wider pl-2 pr-1\">\n            Radius:\n          </span>\n          {([50, 75, 100] as RadiusFilter[]).map((r) => (\n            <button\n              key={r}\n              id={`radius-filter-${r}`}\n              onClick={() => handleRadiusChange(r)}\n              className={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all ${\n                radius === r\n                  ? \'bg-amber-500 text-stone-950 shadow-md shadow-amber-500/20\'\n                  : \'text-stone-400 hover:text-stone-200 hover:bg-stone-800/60\'\n              }`}\n            >\n              {r}m\n            </button>\n          ))}\n        </div>\n\n        {/* View Mode Switcher: 3D Swipe Deck vs 3D Grid vs Radar */}\n        <div className=\"flex items-center gap-1 p-1 rounded-2xl bg-stone-900 border border-stone-800 shadow-inner\">\n          <button\n            id=\"view-deck-btn\"\n            onClick={() => handleViewChange(\'deck\')}\n            aria-label=\"3D Swipe Deck View\"\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all ${\n              viewMode === \'deck\'\n                ? \'bg-stone-800 text-amber-400 border border-amber-500/30 shadow\'\n                : \'text-stone-400 hover:text-stone-200\'\n            }`}\n          >\n            <Layers className=\"w-3.5 h-3.5\" />\n            <span className=\"hidden sm:inline\">3D Deck</span>\n          </button>\n\n          <button\n            id=\"view-grid-btn\"\n            onClick={() => handleViewChange(\'grid\')}\n            aria-label=\"3D Tilt Grid View\"\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all ${\n              viewMode === \'grid\'\n                ? \'bg-stone-800 text-amber-400 border border-amber-500/30 shadow\'\n                : \'text-stone-400 hover:text-stone-200\'\n            }`}\n          >\n            <Grid className=\"w-3.5 h-3.5\" />\n            <span className=\"hidden sm:inline\">3D Grid</span>\n          </button>\n\n          <button\n            id=\"view-radar-btn\"\n            onClick={() => handleViewChange(\'radar\')}\n            aria-label=\"Proximity Radar View\"\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all ${\n              viewMode === \'radar\'\n                ? \'bg-stone-800 text-amber-400 border border-amber-500/30 shadow\'\n                : \'text-stone-400 hover:text-stone-200\'\n            }`}\n          >\n            <Compass className=\"w-3.5 h-3.5\" />\n            <span className=\"hidden sm:inline\">Radar</span>\n          </button>\n\n          {/* Sound Toggle */}\n          <button\n            onClick={toggleSound}\n            aria-label={soundEnabled ? \'Mute haptics\' : \'Enable haptics\'}\n            className=\"p-1.5 rounded-xl text-stone-400 hover:text-amber-400 hover:bg-stone-800 transition-colors ml-1\"\n          >\n            {soundEnabled ? <Volume2 className=\"w-3.5 h-3.5\" /> : <VolumeX className=\"w-3.5 h-3.5 opacity-50\" />}\n          </button>\n        </div>\n      </div>\n\n      {/* Second Row: Price Threshold Chips & Category Filter */}\n      <div className=\"flex items-center justify-between gap-3 overflow-x-auto pb-1 no-scrollbar\">\n        {/* Price filters */}\n        <div className=\"flex items-center gap-1.5 shrink-0\">\n          {[\n            { key: \'all\', label: \'All Deals\' },\n            { key: \'under5\', label: \'Under $5\' },\n            { key: \'under8\', label: \'Under $8\' },\n            { key: \'under10\', label: \'Under $10\' },\n          ].map((item) => (\n            <button\n              key={item.key}\n              id={`price-filter-${item.key}`}\n              onClick={() => handlePriceChange(item.key as PriceFilter)}\n              className={`px-3 py-1 rounded-full text-xs font-medium transition-all ${\n                priceFilter === item.key\n                  ? \'bg-amber-500/20 text-amber-300 border border-amber-500/40\'\n                  : \'bg-stone-900 border border-stone-800 text-stone-400 hover:text-stone-200 hover:border-stone-700\'\n              }`}\n            >\n              {item.label}\n            </button>\n          ))}\n        </div>\n\n        {/* Count badge */}\n        <div className=\"shrink-0 text-xs text-stone-400 font-medium\">\n          <span className=\"text-amber-400 font-bold\">{totalCount}</span> spots nearby\n        </div>\n      </div>\n\n      {/* Horizontal Category Scroll */}\n      <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1 no-scrollbar\">\n        {CATEGORIES.map((cat) => (\n          <button\n            key={cat}\n            onClick={() => {\n              sound.playClick();\n              setSelectedCategory(cat);\n            }}\n            className={`px-2.5 py-1 rounded-lg text-[11px] whitespace-nowrap transition-all ${\n              selectedCategory === cat\n                ? \'bg-stone-800 text-stone-100 font-semibold border border-stone-700\'\n                : \'text-stone-500 hover:text-stone-300\'\n            }`}\n          >\n            {cat}\n          </button>\n        ))}\n      </div>\n    </div>\n  );\n};\n"
    }
