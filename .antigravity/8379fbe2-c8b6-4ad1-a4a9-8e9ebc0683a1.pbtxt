          text: "    const rect = cardRef.current.getBoundingClientRect();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const x = (e.clientX - rect.left) / rect.width - 0.5;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const y = (e.clientY - rect.top) / rect.height - 0.5;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    mouseX.set(x);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
