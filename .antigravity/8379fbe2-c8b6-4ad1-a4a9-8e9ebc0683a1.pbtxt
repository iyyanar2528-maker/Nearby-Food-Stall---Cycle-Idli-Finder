    replacement_chunks {
      target_content: "import React, { useState, useMemo, useEffect } from \'react\';\nimport { FoodSpot, RadiusFilter, PriceFilter, ViewMode } from \'./types\';\nimport { INITIAL_FOOD_SPOTS } from \'./data/foodSpots\';\nimport { Card3DSwipeDeck } from \'./components/Card3DSwipeDeck\';\nimport { Grid3DView } from \'./components/Grid3DView\';\nimport { RadarProximityView } from \'./components/RadarProximityView\';\nimport { FiltersBar } from \'./components/FiltersBar\';\nimport { WalkingRouteModal } from \'./components/WalkingRouteModal\';\nimport { SpotDetailModal } from \'./components/SpotDetailModal\';\nimport { SavedPocketsModal } from \'./components/SavedPocketsModal\';\nimport { \n  Compass, \n  Heart, \n  Sparkles, \n  MapPin, \n  Footprints, \n  Zap, \n  RefreshCw,\n  Flame,\n  Shuffle\n} from \'lucide-react\';\nimport { sound } from \'./utils/audioFeedback\';\n\nexport default function App() {\n  const [spots] = useState<FoodSpot[]>(INITIAL_FOOD_SPOTS);\n  const [radius, setRadius] = useState<RadiusFilter>(100);\n  const [priceFilter, setPriceFilter] = useState<PriceFilter>(\'all\');\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'All\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [viewMode, setViewMode] = useState<ViewMode>(\'deck\');\n  const [soundEnabled, setSoundEnabled] = useState<boolean>(true);\n\n  // Modals & Navigation state\n  const [navigatingSpot, setNavigatingSpot] = useState<FoodSpot | null>(null);\n  const [inspectingSpot, setInspectingSpot] = useState<FoodSpot | null>(null);\n  const [isSavedOpen, setIsSavedOpen] = useState<boolean>(false);\n\n  // Saved Spot IDs (persisted to localStorage)\n  const [savedSpotIds, setSavedSpotIds] = useState<Set<string>>(() => {\n    try {\n      const stored = localStorage.getItem(\'budget_eats_saved\');\n      return stored ? new Set(JSON.parse(stored)) : new Set([\'spot-1\']);\n    } catch {\n      return new Set([\'spot-1\']);\n    }\n  });\n\n  const toggleSave = (spot: FoodSpot) => {\n    setSavedSpotIds((prev) => {\n      const next = new Set(prev);\n      if (next.has(spot.id)) {\n        next.delete(spot.id);\n      } else {\n        next.add(spot.id);\n      }\n      try {\n        localStorage.setItem(\'budget_eats_saved\', JSON.stringify(Array.from(next)));\n      } catch {\n        // storage unavailable\n      }\n      return next;\n    });\n  };\n\n  // Filter spots based on radius, price, and category\n  const filteredSpots = useMemo(() => {\n    return spots.filter((spot) => {\n      // Radius filter\n      if (spot.distanceMeters > radius) return false;\n\n      // Price filter\n      if (priceFilter === \'under5\' && spot.topDeal.price > 5) return false;\n      if (priceFilter === \'under8\' && spot.topDeal.price > 8) return false;\n      if (priceFilter === \'under10\' && spot.topDeal.price > 10) return false;\n\n      // Category filter\n      if (selectedCategory !== \'All\' && spot.category !== selectedCategory) return false;\n\n      // Search query\n      if (searchQuery.trim()) {\n        const q = searchQuery.toLowerCase();\n        const matchName = spot.name.toLowerCase().includes(q);\n        const matchDeal = spot.topDeal.item.toLowerCase().includes(q);\n        const matchCategory = spot.category.toLowerCase().includes(q);\n        if (!matchName && !matchDeal && !matchCategory) return false;\n      }\n\n      return true;\n    });\n  }, [spots, radius, priceFilter, selectedCategory, searchQuery]);\n\n  const savedSpotsList = useMemo(() => {\n    return spots.filter((s) => savedSpotIds.has(s.id));\n  }, [spots, savedSpotIds]);\n\n  // Preload top images for instant rendering on the go\n  useEffect(() => {\n    filteredSpots.slice(0, 4).forEach((s) => {\n      const img = new Image();\n      img.src = s.image;\n    });\n  }, [filteredSpots]);\n\n  // Random surprise budget pick\n  const handleSurprisePick = () => {\n    sound.playSuccess();\n    if (filteredSpots.length > 0) {\n      const randomIndex = Math.floor(Math.random() * filteredSpots.length);\n      setInspectingSpot(filteredSpots[randomIndex]);\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#0A0A0A] text-[#F0F0F0] flex flex-col selection:bg-[#E2FF3B]/30 selection:text-[#E2FF3B]\">\n      {/* Top Mobile-Optimized Header with Artistic Flair */}\n      <header className=\"sticky top-0 z-40 bg-[#0A0A0A]/90 backdrop-blur-md border-b border-[#222222] px-4 py-3\">\n        <div className=\"max-w-4xl mx-auto flex items-center justify-between\">\n          {/* Logo & Ultra-Local Proximity Indicator */}\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-9 h-9 rounded-2xl bg-[#E2FF3B] text-[#0A0A0A] flex items-center justify-center font-black shadow-md shadow-[#E2FF3B]/20\">\n              <Zap className=\"w-4 h-4 fill-[#0A0A0A]\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h1 className=\"text-sm sm:text-base font-extrabold tracking-tight text-[#F0F0F0] font-display\">\n                  50-100m Budget Eats\n                </h1>\n                <span className=\"hidden sm:inline-flex px-1.5 py-0.5 text-[10px] font-mono font-bold rounded-md bg-[#E2FF3B]/15 text-[#E2FF3B] border border-[#E2FF3B]/30 tracking-wider\">\n                  LIVE RADAR\n                </span>\n              </div>\n              <p className=\"text-[11px] text-[#8E8E93] flex items-center gap-1.5 font-mono\">\n                <span className=\"inline-block w-1.5 h-1.5 rounded-full bg-[#E2FF3B] animate-pulse\" />\n                <span>Radius: {radius}m \342\200\242 Fast On-The-Go</span>\n              </p>\n            </div>\n          </div>\n\n          {/* Header Action Buttons */}\n          <div className=\"flex items-center gap-2\">\n            {/* Surprise Quick Pick */}\n            <button\n              id=\"surprise-pick-btn\"\n              onClick={handleSurprisePick}\n              title=\"Random Budget Pick\"\n              className=\"p-2 sm:px-3 sm:py-2 rounded-xl bg-[#141414] border border-[#262626] text-[#D4D4D8] hover:text-[#E2FF3B] hover:border-[#E2FF3B]/40 flex items-center gap-1.5 text-xs font-bold transition-all active:scale-95\"\n            >\n              <Shuffle className=\"w-4 h-4\" />\n              <span className=\"hidden md:inline\">Surprise Me</span>\n            </button>\n\n            {/* Saved Pockets Drawer Button */}\n            <button\n              id=\"saved-pockets-btn\"\n              onClick={() => {\n                sound.playClick();\n                setIsSavedOpen(true);\n              }}\n              className=\"relative p-2 sm:px-3 sm:py-2 rounded-xl bg-[#141414] border border-[#262626] text-[#D4D4D8] hover:text-[#FF5238] hover:border-[#FF5238]/40 flex items-center gap-1.5 text-xs font-bold transition-all active:scale-95\"\n            >\n              <Heart className=\"w-4 h-4 fill-[#FF5238] text-[#FF5238]\" />\n              <span className=\"hidden sm:inline\">Saved</span>\n              {savedSpotIds.size > 0 && (\n                <span className=\"px-1.5 py-0.2 rounded-full bg-[#FF5238] text-white font-bold text-[10px]\">\n                  {savedSpotIds.size}\n                </span>\n              )}\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* Main Experience Body */}\n      <main className=\"flex-1 max-w-4xl w-full mx-auto px-4 py-5 flex flex-col\">\n        {/* Radius, Price Filters & View Controls */}\n        <FiltersBar\n          radius={radius}\n          setRadius={setRadius}\n          priceFilter={priceFilter}\n          setPriceFilter={setPriceFilter}\n          viewMode={viewMode}\n          setViewMode={setViewMode}\n          selectedCategory={selectedCategory}\n          setSelectedCategory={setSelectedCategory}\n          searchQuery={searchQuery}\n          setSearchQuery={setSearchQuery}\n          soundEnabled={soundEnabled}\n          setSoundEnabled={setSoundEnabled}\n          totalCount={filteredSpots.length}\n        />\n\n        {/* View Renderer */}\n        <div className=\"flex-1 flex flex-col justify-center\">\n          {viewMode === \'deck\' && (\n            <Card3DSwipeDeck\n              spots={filteredSpots}\n              savedSpotIds={savedSpotIds}\n              onToggleSave={toggleSave}\n              onNavigate={(spot) => setNavigatingSpot(spot)}\n              onOpenDetails={(spot) => setInspectingSpot(spot)}\n              onResetDeck={() => setRadius(100)}\n            />\n          )}\n\n          {viewMode === \'grid\' && (\n            <Grid3DView\n              spots={filteredSpots}\n              savedSpotIds={savedSpotIds}\n              onNavigate={(spot) => setNavigatingSpot(spot)}\n              onOpenDetails={(spot) => setInspectingSpot(spot)}\n              onToggleSave={toggleSave}\n            />\n          )}\n\n          {viewMode === \'radar\' && (\n            <RadarProximityView\n              spots={spots}\n              radiusLimit={radius}\n              onNavigate={(spot) => setNavigatingSpot(spot)}\n              onOpenDetails={(spot) => setInspectingSpot(spot)}\n              onToggleSave={toggleSave}\n              savedSpotIds={savedSpotIds}\n            />\n          )}\n        </div>\n      </main>\n\n      {/* Footer info pill */}\n      <footer className=\"py-4 text-center text-xs text-[#8E8E93] border-t border-[#1F1F1F]\">\n        <div className=\"max-w-md mx-auto px-4 flex items-center justify-between text-[11px] font-mono\">\n          <span className=\"flex items-center gap-1.5 text-[#A1A1AA]\">\n            <Footprints className=\"w-3.5 h-3.5 text-[#E2FF3B]\" />\n            <span>Avg. walk: ~60s (75m radius)</span>\n          </span>\n          <span className=\"flex items-center gap-1 text-[#71717A]\">\n            <span>Prices verified ultra-local</span>\n          </span>\n        </div>\n      </footer>\n\n      {/* Modals & Overlays */}\n      <WalkingRouteModal\n        spot={navigatingSpot}\n        onClose={() => setNavigatingSpot(null)}\n      />\n\n      <SpotDetailModal\n        spot={inspectingSpot}\n        onClose={() => setInspectingSpot(null)}\n        onNavigate={(spot) => setNavigatingSpot(spot)}\n        onToggleSave={toggleSave}\n        isSaved={inspectingSpot ? savedSpotIds.has(inspectingSpot.id) : false}\n      />\n\n      <SavedPocketsModal\n        isOpen={isSavedOpen}\n        onClose={() => setIsSavedOpen(false)}\n        savedSpots={savedSpotsList}\n        onRemoveSave={toggleSave}\n        onNavigate={(spot) => setNavigatingSpot(spot)}\n      />\n    </div>\n  );\n}"
      replacement_content: "import React, { useState, useMemo, useEffect } from \'react\';\nimport { FoodSpot, RadiusFilter, PriceFilter, ViewMode, CityRegion } from \'./types\';\nimport { INITIAL_FOOD_SPOTS } from \'./data/foodSpots\';\nimport { Card3DSwipeDeck } from \'./components/Card3DSwipeDeck\';\nimport { Grid3DView } from \'./components/Grid3DView\';\nimport { RadarProximityView } from \'./components/RadarProximityView\';\nimport { FiltersBar } from \'./components/FiltersBar\';\nimport { WalkingRouteModal } from \'./components/WalkingRouteModal\';\nimport { SpotDetailModal } from \'./components/SpotDetailModal\';\nimport { SavedPocketsModal } from \'./components/SavedPocketsModal\';\nimport { \n  Compass, \n  Heart, \n  Sparkles, \n  MapPin, \n  Footprints, \n  Zap, \n  RefreshCw,\n  Flame,\n  Shuffle\n} from \'lucide-react\';\nimport { sound } from \'./utils/audioFeedback\';\n\nexport default function App() {\n  const [spots] = useState<FoodSpot[]>(INITIAL_FOOD_SPOTS);\n  const [cityRegion, setCityRegion] = useState<CityRegion>(\'all\');\n  const [radius, setRadius] = useState<RadiusFilter>(100);\n  const [priceFilter, setPriceFilter] = useState<PriceFilter>(\'all\');\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'All\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [viewMode, setViewMode] = useState<ViewMode>(\'deck\');\n  const [soundEnabled, setSoundEnabled] = useState<boolean>(true);\n\n  // Modals & Navigation state\n  const [navigatingSpot, setNavigatingSpot] = useState<FoodSpot | null>(null);\n  const [inspectingSpot, setInspectingSpot] = useState<FoodSpot | null>(null);\n  const [isSavedOpen, setIsSavedOpen] = useState<boolean>(false);\n\n  // Saved Spot IDs (persisted to localStorage)\n  const [savedSpotIds, setSavedSpotIds] = useState<Set<string>>(() => {\n    try {\n      const stored = localStorage.getItem(\'budget_eats_saved_inr\');\n      return stored ? new Set(JSON.parse(stored)) : new Set([\'spot-mum-1\', \'spot-tn-1\']);\n    } catch {\n      return new Set([\'spot-mum-1\', \'spot-tn-1\']);\n    }\n  });\n\n  const toggleSave = (spot: FoodSpot) => {\n    setSavedSpotIds((prev) => {\n      const next = new Set(prev);\n      if (next.has(spot.id)) {\n        next.delete(spot.id);\n      } else {\n        next.add(spot.id);\n      }\n      try {\n        localStorage.setItem(\'budget_eats_saved_inr\', JSON.stringify(Array.from(next)));\n      } catch {\n        // storage unavailable\n      }\n      return next;\n    });\n  };\n\n  // Filter spots based on region, radius, price, and category\n  const filteredSpots = useMemo(() => {\n    return spots.filter((spot) => {\n      // Region filter (Mumbai vs Tamil Nadu vs All)\n      if (cityRegion !== \'all\' && spot.region !== cityRegion) return false;\n\n      // Radius filter\n      if (spot.distanceMeters > radius) return false;\n\n      // Price filter (in INR)\n      if (priceFilter === \'under50\' && spot.topDeal.price > 50) return false;\n      if (priceFilter === \'under100\' && spot.topDeal.price > 100) return false;\n      if (priceFilter === \'under150\' && spot.topDeal.price > 150) return false;\n\n      // Category filter\n      if (selectedCategory !== \'All\' && spot.category !== selectedCategory) return false;\n\n      // Search query\n      if (searchQuery.trim()) {\n        const q = searchQuery.toLowerCase();\n        const matchName = spot.name.toLowerCase().includes(q);\n        const matchDeal = spot.topDeal.item.toLowerCase().includes(q);\n        const matchCategory = spot.category.toLowerCase().includes(q);\n        const matchAddress = spot.address.toLowerCase().includes(q);\n        const matchRegion = spot.regionLabel.toLowerCase().includes(q);\n        if (!matchName && !matchDeal && !matchCategory && !matchAddress && !matchRegion) return false;\n      }\n\n      return true;\n    });\n  }, [spots, cityRegion, radius, priceFilter, selectedCategory, searchQuery]);\n\n  const savedSpotsList = useMemo(() => {\n    return spots.filter((s) => savedSpotIds.has(s.id));\n  }, [spots, savedSpotIds]);\n\n  // Preload top images for instant rendering on the go\n  useEffect(() => {\n    filteredSpots.slice(0, 4).forEach((s) => {\n      const img = new Image();\n      img.src = s.image;\n    });\n  }, [filteredSpots]);\n\n  // Random surprise budget pick\n  const handleSurprisePick = () => {\n    sound.playSuccess();\n    if (filteredSpots.length > 0) {\n      const randomIndex = Math.floor(Math.random() * filteredSpots.length);\n      setInspectingSpot(filteredSpots[randomIndex]);\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#0A0A0A] text-[#F0F0F0] flex flex-col selection:bg-[#E2FF3B]/30 selection:text-[#E2FF3B]\">\n      {/* Top Mobile-Optimized Header with Artistic Flair */}\n      <header className=\"sticky top-0 z-40 bg-[#0A0A0A]/90 backdrop-blur-md border-b border-[#222222] px-4 py-3\">\n        <div className=\"max-w-4xl mx-auto flex items-center justify-between\">\n          {/* Logo & Ultra-Local Proximity Indicator */}\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-9 h-9 rounded-2xl bg-[#E2FF3B] text-[#0A0A0A] flex items-center justify-center font-black shadow-md shadow-[#E2FF3B]/20\">\n              <Zap className=\"w-4 h-4 fill-[#0A0A0A]\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h1 className=\"text-sm sm:text-base font-extrabold tracking-tight text-[#F0F0F0] font-display\">\n                  50-100m Budget Eats\n                </h1>\n                <span className=\"hidden sm:inline-flex px-1.5 py-0.5 text-[10px] font-mono font-bold rounded-md bg-[#E2FF3B]/15 text-[#E2FF3B] border border-[#E2FF3B]/30 tracking-wider\">\n                  MUMBAI & TN (\342\202\271)\n                </span>\n              </div>\n              <p className=\"text-[11px] text-[#8E8E93] flex items-center gap-1.5 font-mono\">\n                <span className=\"inline-block w-1.5 h-1.5 rounded-full bg-[#E2FF3B] animate-pulse\" />\n                <span>\n                  {cityRegion === \'all\'\n                    ? \'Mumbai & Tamil Nadu\'\n                    : cityRegion === \'mumbai\'\n                    ? \'Mumbai, Maharashtra\'\n                    : \'Tamil Nadu (Chennai/Madurai)\'}{\' \'}\n                  \342\200\242 {radius}m Radius\n                </span>\n              </p>\n            </div>\n          </div>\n\n          {/* Header Action Buttons */}\n          <div className=\"flex items-center gap-2\">\n            {/* Surprise Quick Pick */}\n            <button\n              id=\"surprise-pick-btn\"\n              onClick={handleSurprisePick}\n              title=\"Random Budget Pick\"\n              className=\"p-2 sm:px-3 sm:py-2 rounded-xl bg-[#141414] border border-[#262626] text-[#D4D4D8] hover:text-[#E2FF3B] hover:border-[#E2FF3B]/40 flex items-center gap-1.5 text-xs font-bold transition-all active:scale-95\"\n            >\n              <Shuffle className=\"w-4 h-4\" />\n              <span className=\"hidden md:inline\">Surprise Me</span>\n            </button>\n\n            {/* Saved Pockets Drawer Button */}\n            <button\n              id=\"saved-pockets-btn\"\n              onClick={() => {\n                sound.playClick();\n                setIsSavedOpen(true);\n              }}\n              className=\"relative p-2 sm:px-3 sm:py-2 rounded-xl bg-[#141414] border border-[#262626] text-[#D4D4D8] hover:text-[#FF5238] hover:border-[#FF5238]/40 flex items-center gap-1.5 text-xs font-bold transition-all active:scale-95\"\n            >\n              <Heart className=\"w-4 h-4 fill-[#FF5238] text-[#FF5238]\" />\n              <span className=\"hidden sm:inline\">Saved</span>\n              {savedSpotIds.size > 0 && (\n                <span className=\"px-1.5 py-0.2 rounded-full bg-[#FF5238] text-white font-bold text-[10px]\">\n                  {savedSpotIds.size}\n                </span>\n              )}\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* Main Experience Body */}\n      <main className=\"flex-1 max-w-4xl w-full mx-auto px-4 py-5 flex flex-col\">\n        {/* Radius, Price Filters & View Controls */}\n        <FiltersBar\n          cityRegion={cityRegion}\n          setCityRegion={setCityRegion}\n          radius={radius}\n          setRadius={setRadius}\n          priceFilter={priceFilter}\n          setPriceFilter={setPriceFilter}\n          viewMode={viewMode}\n          setViewMode={setViewMode}\n          selectedCategory={selectedCategory}\n          setSelectedCategory={setSelectedCategory}\n          searchQuery={searchQuery}\n          setSearchQuery={setSearchQuery}\n          soundEnabled={soundEnabled}\n          setSoundEnabled={setSoundEnabled}\n          totalCount={filteredSpots.length}\n        />\n\n        {/* View Renderer */}\n        <div className=\"flex-1 flex flex-col justify-center\">\n          {viewMode === \'deck\' && (\n            <Card3DSwipeDeck\n              spots={filteredSpots}\n              savedSpotIds={savedSpotIds}\n              onToggleSave={toggleSave}\n              onNavigate={(spot) => setNavigatingSpot(spot)}\n              onOpenDetails={(spot) => setInspectingSpot(spot)}\n              onResetDeck={() => {\n                setCityRegion(\'all\');\n                setRadius(100);\n                setSelectedCategory(\'All\');\n              }}\n            />\n          )}\n\n          {viewMode === \'grid\' && (\n            <Grid3DView\n              spots={filteredSpots}\n              savedSpotIds={savedSpotIds}\n              onNavigate={(spot) => setNavigatingSpot(spot)}\n              onOpenDetails={(spot) => setInspectingSpot(spot)}\n              onToggleSave={toggleSave}\n            />\n          )}\n\n          {viewMode === \'radar\' && (\n            <RadarProximityView\n              spots={filteredSpots}\n              radiusLimit={radius}\n              onNavigate={(spot) => setNavigatingSpot(spot)}\n              onOpenDetails={(spot) => setInspectingSpot(spot)}\n              onToggleSave={toggleSave}\n              savedSpotIds={savedSpotIds}\n            />\n          )}\n        </div>\n      </main>\n\n      {/* Footer info pill */}\n      <footer className=\"py-4 text-center text-xs text-[#8E8E93] border-t border-[#1F1F1F]\">\n        <div className=\"max-w-md mx-auto px-4 flex items-center justify-between text-[11px] font-mono\">\n          <span className=\"flex items-center gap-1.5 text-[#A1A1AA]\">\n            <Footprints className=\"w-3.5 h-3.5 text-[#E2FF3B]\" />\n            <span>Avg. walk: ~50s (65m radius)</span>\n          </span>\n          <span className=\"flex items-center gap-1 text-[#71717A]\">\n            <span>UPI / Cash Accepted</span>\n          </span>\n        </div>\n      </footer>\n\n      {/* Modals & Overlays */}\n      <WalkingRouteModal\n        spot={navigatingSpot}\n        onClose={() => setNavigatingSpot(null)}\n      />\n\n      <SpotDetailModal\n        spot={inspectingSpot}\n        onClose={() => setInspectingSpot(null)}\n        onNavigate={(spot) => setNavigatingSpot(spot)}\n        onToggleSave={toggleSave}\n        isSaved={inspectingSpot ? savedSpotIds.has(inspectingSpot.id) : false}\n      />\n\n      <SavedPocketsModal\n        isOpen={isSavedOpen}\n        onClose={() => setIsSavedOpen(false)}\n        savedSpots={savedSpotsList}\n        onRemoveSave={toggleSave}\n        onNavigate={(spot) => setNavigatingSpot(spot)}\n      />\n    </div>\n  );\n}"
    }
