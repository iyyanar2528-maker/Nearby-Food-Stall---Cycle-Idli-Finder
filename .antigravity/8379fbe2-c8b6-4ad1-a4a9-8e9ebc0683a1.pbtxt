  file_change {
    absolute_path_uri: "file:///src/components/WalkingRouteModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { FoodSpot } from \'../types\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { \n  Navigation, \n  X, \n  Compass, \n  Footprints, \n  Clock, \n  CheckCircle2, \n  MapPin, \n  Sparkles,\n  Volume2,\n  VolumeX,\n  Flame\n} from \'lucide-react\';\nimport { FastImage } from \'./FastImage\';\nimport { sound } from \'../utils/audioFeedback\';\n\ninterface WalkingRouteModalProps {\n  spot: FoodSpot | null;\n  onClose: () => void;\n}\n\nexport const WalkingRouteModal: React.FC<WalkingRouteModalProps> = ({ spot, onClose }) => {\n  const [stepsLeft, setStepsLeft] = useState(0);\n  const [secondsLeft, setSecondsLeft] = useState(0);\n  const [isArrived, setIsArrived] = useState(false);\n  const [isSimulating, setIsSimulating] = useState(true);\n\n  useEffect(() => {\n    if (!spot) return;\n    setStepsLeft(spot.stepsCount);\n    setSecondsLeft(spot.walkingTimeSeconds);\n    setIsArrived(false);\n    setIsSimulating(true);\n\n    const interval = setInterval(() => {\n      setStepsLeft((prev) => {\n        if (prev <= 2) {\n          setIsArrived(true);\n          sound.playSuccess();\n          return 0;\n        }\n        return prev - 2;\n      });\n\n      setSecondsLeft((prev) => {\n        if (prev <= 1) return 0;\n        return prev - 1;\n      });\n    }, 1000);\n\n    return () => clearInterval(interval);\n  }, [spot]);\n\n  if (!spot) return null;\n\n  const totalSteps = spot.stepsCount;\n  const progressPercent = Math.min(100, Math.round(((totalSteps - stepsLeft) / totalSteps) * 100));\n\n  return (\n    <AnimatePresence>\n      <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-stone-950/80 backdrop-blur-md\">\n        <motion.div\n          initial={{ opacity: 0, scale: 0.9, y: 20 }}\n          animate={{ opacity: 1, scale: 1, y: 0 }}\n          exit={{ opacity: 0, scale: 0.9, y: 20 }}\n          className=\"w-full max-w-md bg-stone-900 border border-amber-500/30 rounded-3xl p-5 shadow-2xl relative overflow-hidden\"\n        >\n          {/* Header */}\n          <div className=\"flex items-center justify-between pb-3 border-b border-stone-800\">\n            <div className=\"flex items-center gap-2.5\">\n              <div className=\"w-8 h-8 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center\">\n                <Navigation className=\"w-4 h-4 fill-amber-400\" />\n              </div>\n              <div>\n                <h3 className=\"text-sm font-bold text-stone-100\">Live Walking Route</h3>\n                <p className=\"text-[11px] text-amber-400 font-semibold\">{spot.distanceMeters}m ({spot.walkingTimeSeconds}s away)</p>\n              </div>\n            </div>\n            <button\n              onClick={() => {\n                sound.playClick();\n                onClose();\n              }}\n              className=\"p-1.5 rounded-full bg-stone-800 text-stone-300 hover:text-white\"\n              aria-label=\"Close navigation\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n          </div>\n\n          {/* Destination Preview Card */}\n          <div className=\"mt-4 p-3 rounded-2xl bg-stone-950/70 border border-stone-800 flex items-center gap-3\">\n            <div className=\"w-14 h-14 rounded-xl overflow-hidden shrink-0 border border-stone-700\">\n              <FastImage src={spot.image} alt={spot.name} className=\"w-full h-full\" />\n            </div>\n            <div className=\"min-w-0\">\n              <div className=\"text-xs font-bold text-stone-100 truncate\">{spot.name}</div>\n              <div className=\"text-[11px] text-amber-400 font-semibold truncate flex items-center gap-1 mt-0.5\">\n                <Flame className=\"w-3 h-3 text-amber-400\" />\n                <span>{spot.topDeal.item} (${spot.topDeal.price.toFixed(2)})</span>\n              </div>\n              <div className=\"text-[10px] text-stone-400 truncate mt-0.5\">{spot.address}</div>\n            </div>\n          </div>\n\n          {/* Compass & Distance Dial */}\n          <div className=\"my-5 flex flex-col items-center\">\n            {isArrived ? (\n              <div className=\"text-center py-4\">\n                <div className=\"w-16 h-16 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center mx-auto mb-3 animate-bounce\">\n                  <CheckCircle2 className=\"w-8 h-8\" />\n                </div>\n                <h4 className=\"text-lg font-extrabold text-stone-100\">You Arrived!</h4>\n                <p className=\"text-xs text-stone-400 mt-1 max-w-xs\">\n                  Order the <span className=\"text-amber-400 font-bold\">{spot.topDeal.item}</span> for <span className=\"text-emerald-400 font-bold\">${spot.topDeal.price.toFixed(2)}</span>.\n                </p>\n              </div>\n            ) : (\n              <>\n                <div className=\"relative w-36 h-36 flex items-center justify-center\">\n                  {/* Outer Orbit */}\n                  <div className=\"absolute inset-0 rounded-full border-2 border-stone-800\" />\n                  \n                  {/* Rotating Compass Heading Indicator */}\n                  <motion.div\n                    animate={{ rotate: spot.bearingDegrees }}\n                    transition={{ type: \'spring\', damping: 15 }}\n                    className=\"absolute inset-2 flex items-center justify-center pointer-events-none\"\n                  >\n                    <div className=\"w-full h-[2px] relative flex justify-end\">\n                      <div className=\"w-4 h-4 bg-amber-400 rotate-45 transform translate-x-2 -translate-y-1 shadow-lg shadow-amber-400/50\" />\n                    </div>\n                  </motion.div>\n\n                  {/* Central Stats */}\n                  <div className=\"text-center z-10\">\n                    <span className=\"text-2xl font-black text-amber-400 tracking-tight\">\n                      {stepsLeft}\n                    </span>\n                    <span className=\"block text-[10px] uppercase font-bold text-stone-400 tracking-wider\">\n                      Steps Left\n                    </span>\n                    <span className=\"block text-[10px] text-stone-500 font-mono mt-0.5\">\n                      ~{secondsLeft}s\n                    </span>\n                  </div>\n                </div>\n\n                {/* Progress bar */}\n                <div className=\"w-full mt-4 bg-stone-800 h-2 rounded-full overflow-hidden\">\n                  <motion.div\n                    className=\"h-full bg-gradient-to-r from-amber-500 to-emerald-400 rounded-full\"\n                    style={{ width: `${progressPercent}%` }}\n                    transition={{ ease: \'linear\' }}\n                  />\n                </div>\n                <div className=\"w-full flex justify-between text-[10px] text-stone-400 mt-1 font-mono\">\n                  <span>Current Spot</span>\n                  <span>{progressPercent}% Walked</span>\n                  <span>Destination</span>\n                </div>\n              </>\n            )}\n          </div>\n\n          {/* Turn by Turn Walking Directions */}\n          <div className=\"space-y-2 text-xs\">\n            <div className=\"p-2.5 rounded-xl bg-stone-950/60 border border-stone-800 flex items-start gap-2.5\">\n              <span className=\"w-5 h-5 rounded-full bg-stone-800 text-stone-300 font-bold flex items-center justify-center shrink-0 text-[10px]\">\n                1\n              </span>\n              <div>\n                <p className=\"text-stone-200 font-medium\">Head toward bearing {spot.bearingDegrees}\302\260</p>\n                <p className=\"text-[10px] text-stone-400\">Exit and turn towards the main walkway.</p>\n              </div>\n            </div>\n\n            <div className=\"p-2.5 rounded-xl bg-stone-950/60 border border-stone-800 flex items-start gap-2.5\">\n              <span className=\"w-5 h-5 rounded-full bg-amber-500/20 text-amber-400 font-bold flex items-center justify-center shrink-0 text-[10px]\">\n                2\n              </span>\n              <div>\n                <p className=\"text-stone-200 font-medium\">Spot landmark: {spot.address}</p>\n                <p className=\"text-[10px] text-stone-400\">Look for counter window / canopy banner.</p>\n              </div>\n            </div>\n          </div>\n\n          {/* Done Button */}\n          <div className=\"mt-4 pt-3 border-t border-stone-800 flex gap-2\">\n            <button\n              onClick={() => {\n                sound.playClick();\n                onClose();\n              }}\n              className=\"w-full py-2.5 rounded-xl bg-stone-800 hover:bg-stone-700 text-stone-200 text-xs font-bold transition-colors\"\n            >\n              {isArrived ? \'Close\' : \'Cancel Route\'}\n            </button>\n          </div>\n        </motion.div>\n      </div>\n    </AnimatePresence>\n  );\n};\n"
    }
