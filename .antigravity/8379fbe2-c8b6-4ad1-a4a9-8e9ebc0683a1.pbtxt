sound.playClick();\n                    onClose();\n                  }}\n                  className=\"p-2 rounded-full bg-stone-950/70 backdrop-blur-md border border-stone-700 text-stone-200 hover:text-white\"\n                >\n                  <X className=\"w-4 h-4\" />\n                </button>\n              </div>\n            </div>\n\n            {/* Photo thumbnails */}\n            {spot.photos.length > 1 && (\n              <div className=\"absolute bottom-3 right-4 flex gap-1.5 z-20\">\n                {spot.photos.map((photo, i) => (\n                  <button\n                    key={i}\n                    onClick={() => {\n                      sound.playClick();\n                      setActivePhotoIdx(i);\n                    }}\n                    className={`w-9 h-9 rounded-lg overflow-hidden border-2 transition-all ${\n                      activePhotoIdx === i ? \'border-amber-400 scale-105\' : \'border-stone-600 opacity-60\'\n                    }`}\n                  >\n                    <img src={photo} alt=\"\" referrerPolicy=\"no-referrer\" className=\"w-full h-full object-cover\" />\n                  </button>\n                ))}\n              </div>\n            )}\n          </div>\n\n          {/* Scrollable Content */}\n          <div className=\"p-5 overflow-y-auto space-y-5 flex-1\">\n            {/* Title & Ratings */}\n            <div>\n              <div className=\"flex items-center justify-between text-xs text-stone-400 mb-1\">\n                <span className=\"px-2 py-0.5 rounded bg-stone-800 text-stone-300 font-medium\">\n                  {spot.category}\n                </span>\n                <span className=\"text-amber-400 font-bold\">\n                  \342\230\205 {spot.rating} ({spot.reviewCount} reviews)\n                </span>\n              </div>\n              <h2 className=\"text-xl font-bold text-stone-100\">{spot.name}</h2>\n              <p className=\"text-xs text-stone-400 flex items-center gap-1 mt-1\">\n                <MapPin className=\"w-3.5 h-3.5 text-stone-500\" />\n                <span>{spot.address}</span>\n              </p>\n            </div>\n\n            {/* Top Deal Highlight */}\n            <div className=\"p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-between\">\n              <div className=\"flex items-center gap-2.5\">\n                <div className=\"w-9 h-9 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center\">\n                  <Flame className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <div className=\"text-[11px] font-bold text-amber-400 uppercase tracking-wide\">\n                    {spot.topDeal.badge}\n                  </div>\n                  <div className=\"text-xs font-bold text-stone-100\">\n                    {spot.topDeal.item}\n                  </div>\n                </div>\n              </div>\n              <div className=\"text-right\">\n                <span className=\"text-lg font-black text-amber-400\">\n                  ${spot.topDeal.price.toFixed(2)}\n                </span>\n              </div>\n            </div>\n\n            {/* Description & Secret Pro Tip */}\n            <div>\n              <h4 className=\"text-xs font-bold text-stone-300 uppercase tracking-wider mb-1.5\">\n                About this Spot\n              </h4>\n              <p className=\"text-xs text-stone-300 leading-relaxed\">\n                {spot.description}\n              </p>\n\n              <div className=\"mt-2.5 p-3 rounded-xl bg-stone-800/80 border border-stone-700/60 text-xs text-stone-300 flex items-start gap-2\">\n                <Sparkles className=\"w-4 h-4 text-amber-400 shrink-0 mt-0.5\" />\n                <div>\n                  <span className=\"font-bold text-amber-300\">Local Hack: </span>\n                  <span>{spot.secretTip}</span>\n                </div>\n              </div>\n            </div>\n\n            {/* Full Low-Budget Menu */}\n            <div>\n              <h4 className=\"text-xs font-bold text-stone-300 uppercase tracking-wider mb-2\">\n                Full Budget Menu\n              </h4>\n              <div className=\"space-y-2\">\n                {spot.menu.map((item) => (\n                  <div\n                    key={item.id}\n                    className=\"p-3 rounded-xl bg-stone-800/60 border border-stone-750 flex items-center justify-between gap-3\"\n                  >\n                    <div className=\"min-w-0\">\n                      <div className=\"flex items-center gap-2\">\n                        <span className=\"text-xs font-bold text-stone-100 truncate\">\n                          {item.name}\n                        </span>\n                        {item.isBestseller && (\n                          <span className=\"text-[9px] px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-300 font-semibold\">\n                            Top Pick\n                          </span>\n                        )}\n                      </div>\n                      <p className=\"text-[11px] text-stone-400 mt-0.5\">\n                        {item.description}\n                      </p>\n                    </div>\n                    <span className=\"text-xs font-extrabold text-amber-400 shrink-0\">\n                      ${item.price.toFixed(2)}\n                    </span>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            {/* Quick Details: Hours, Payments, Dietary */}\n            <div className=\"grid grid-cols-2 gap-2.5 text-xs\">\n              <div className=\"p-3 rounded-xl bg-stone-800/50 border border-stone-750\">\n                <div className=\"flex items-center gap-1.5 text-stone-400 mb-1\">\n                  <Clock className=\"w-3.5 h-3.5\" />\n                  <span className=\"font-semibold text-[11px]\">Hours</span>\n                </div>\n 