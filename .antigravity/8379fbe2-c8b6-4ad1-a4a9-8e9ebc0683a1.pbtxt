         <div\n                  key={spot.id}\n                  className=\"p-3 rounded-2xl bg-stone-950/70 border border-stone-800 flex items-center justify-between gap-3\"\n                >\n                  <div className=\"flex items-center gap-3 min-w-0\">\n                    <div className=\"w-14 h-14 rounded-xl overflow-hidden shrink-0 border border-stone-700\">\n                      <FastImage src={spot.image} alt={spot.name} className=\"w-full h-full\" />\n                    </div>\n                    <div className=\"min-w-0\">\n                      <div className=\"text-xs font-bold text-stone-100 truncate\">{spot.name}</div>\n                      <div className=\"text-[11px] text-amber-400 font-semibold truncate flex items-center gap-1 mt-0.5\">\n                        <Flame className=\"w-3 h-3\" />\n                        <span>${spot.topDeal.price.toFixed(2)} \342\200\242 {spot.topDeal.item}</span>\n                      </div>\n                      <div className=\"text-[10px] text-stone-400 truncate mt-0.5\">\n                        {spot.distanceMeters}m away \342\200\242 {spot.walkingTimeSeconds}s walk\n                      </div>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-1.5 shrink-0\">\n                    <button\n                      onClick={() => {\n                        sound.playSuccess();\n                        onNavigate(spot);\n                        onClose();\n                      }}\n                      className=\"p-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-stone-950 font-bold text-xs flex items-center gap-1 transition-colors\"\n                      title=\"Walk there\"\n                    >\n                      <Navigation className=\"w-3.5 h-3.5 fill-stone-950\" />\n                    </button>\n                    <button\n                      onClick={() => {\n                        sound.playClick();\n                        onRemoveSave(spot);\n                      }}\n                      className=\"p-2.5 rounded-xl bg-stone-800 hover:bg-rose-500/20 text-stone-400 hover:text-rose-400 border border-stone-700 transition-colors\"\n                      title=\"Remove\"\n                    >\n                      <Trash2 className=\"w-3.5 h-3.5\" />\n                    </button>\n                  </div>\n                </div>\n              ))\n            )}\n          </div>"
      replacement_content: "        <motion.div\n          initial={{ opacity: 0, scale: 0.95, y: 15 }}\n          animate={{ opacity: 1, scale: 1, y: 0 }}\n          exit={{ opacity: 0, scale: 0.95, y: 15 }}\n          className=\"w-full max-w-md bg-[#121212] border border-[#262626] rounded-3xl p-5 shadow-2xl flex flex-col max-h-[85vh] overflow-hidden\"\n        >\n          {/* Header */}\n          <div className=\"flex items-center justify-between pb-3 border-b border-[#262626]\">\n            <div className=\"flex items-center gap-2\">\n              <div className=\"w-8 h-8 rounded-xl bg-[#FF5238]/20 text-[#FF5238] flex items-center justify-center\">\n                <Heart className=\"w-4 h-4 fill-[#FF5238]\" />\n              </div>\n              <div>\n                <h3 className=\"text-sm font-bold text-[#F0F0F0] font-display\">Saved Cheap Eats</h3>\n                <p className=\"text-[11px] text-[#8E8E93] font-mono\">{savedSpots.length} bookmarked spots</p>\n              </div>\n            </div>\n            <button\n              onClick={() => {\n                sound.playClick();\n                onClose();\n              }}\n              className=\"p-1.5 rounded-full bg-[#1C1C1E] text-[#8E8E93] hover:text-white border border-[#2E2E32]\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n          </div>\n\n          {/* List of Saved Spots */}\n          <div className=\"mt-4 space-y-3 overflow-y-auto flex-1 pr-1\">\n            {savedSpots.length === 0 ? (\n              <div className=\"py-12 text-center text-[#8E8E93] font-mono\">\n                <Heart className=\"w-8 h-8 mx-auto text-[#444444] mb-2\" />\n                <p className=\"text-xs font-bold text-[#D4D4D8]\">No saved food spots yet</p>\n                <p className=\"text-[11px] text-[#71717A] mt-1 font-sans\">\n                  Swipe right or tap the heart icon on any card to save it for quick access.\n                </p>\n              </div>\n            ) : (\n              savedSpots.map((spot) => (\n                <div\n                  key={spot.id}\n                  className=\"p-3 rounded-2xl bg-[#0A0A0A] border border-[#262626] flex items-center justify-between gap-3\"\n                >\n                  <div className=\"flex items-center gap-3 min-w-0\">\n                    <div className=\"w-14 h-14 rounded-xl overflow-hidden shrink-0 border border-[#2E2E32]\">\n                      <FastImage src={spot.image} alt={spot.name} className=\"w-full h-full\" />\n                    </div>\n                    <div className=\"min-w-0\">\n                      <div className=\"text-xs font-bold text-[#F0F0F0] truncate font-display\">{spot.name}</div>\n                      <div className=\"text-[11px] text-[#E2FF3B] font-bold font-mono truncate flex items-center gap-1 mt-0.5\">\n                        <Flame className=\"w-3 h-3 text-[#E2FF3B]\" />\n                        <span>${spot.topDeal.price.toFixed(2)} \342\200\242 {spot.topDeal.item}</span>\n                      </div>\n                      <div className=\"text-[10px] text-[#8E8E93] font-mono truncate mt-0.5\">\n                        {spot.distanceMeters}m away \342\200\242 {spot.walkingTimeSeconds}s walk\n                      </div>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-1.5 shrink-0\">\n                    <button\n                      onClick={() => {\n                        sound.playSuccess();\n                        onNavigate(spot);\n                        onClose();\n                      }}\n                      className=\"p-2.5 rounded-xl bg-[#E2FF3B] hover:bg-[#d5f330] text-[#0A0A0A] font-extrabold text-xs flex items-center gap-1 transition-colors shadow-md\"\n                      title=\"Walk there\"\n                    >\n                      <Navigation className=\"w-3.5 h-3.5 fill-[#0A0A0A]\" />\n                    </button>\n 