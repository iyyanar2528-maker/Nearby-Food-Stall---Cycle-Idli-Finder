      replacement_content: "import { FoodSpot } from \'../types\';\n\nexport const INITIAL_FOOD_SPOTS: FoodSpot[] = [\n  // MUMBAI, MAHARASHTRA SPOTS\n  {\n    id: \'spot-mum-1\',\n    name: \'Ashok Vada Pav & Crispy Chura Stall\',\n    region: \'mumbai\',\n    regionLabel: \'Dadar, Mumbai (MH)\',\n    category: \'Vada Pav & Chaat\',\n    image: \'https://images.unsplash.com/photo-1626777552726-4a6b54c97e46?auto=format&fit=crop&w=1200&q=85\',\n    thumbnail: \'https://images.unsplash.com/photo-1626777552726-4a6b54c97e46?auto=format&fit=crop&w=300&q=70\',\n    rating: 4.9,\n    reviewCount: 1840,\n    priceRange: \'\342\202\271\',\n    topDeal: {\n      item: \'Jumbo Vada Pav with Golden Garlic Chura\',\n      price: 25,\n      badge: \'Iconic Mumbai Vada Pav \342\202\27125\'\n    },\n    distanceMeters: 52,\n    walkingTimeSeconds: 40,\n    stepsCount: 68,\n    bearingDegrees: 25,\n    address: \'Near Kirti College, Dadar West, Mumbai, Maharashtra 400028\',\n    openingHours: \'10:30 AM \342\200\223 9:30 PM\',\n    isOpenNow: true,\n    dietaryTags: [\'100% Vegetarian\', \'Garlic Chutney\', \'Jain Option\'],\n    paymentTypes: [\'UPI / GPay\', \'Cash\', \'PhonePe / Paytm\'],\n    description: \'The undisputed gold standard of Mumbai Vada Pav since 1992. Piping hot spiced potato fritter encased in a fresh pillowy ladi pav with red garlic powder and crunchy besan chura.\',\n    secretTip: \'Ask the bhaiya for \"extra chura and double theekhi green chutney\" sprinkled inside the pav.\',\n    menu: [\n      { id: \'m1\', name: \'Signature Chura Vada Pav\', price: 25, description: \'Golden batata vada layered with fiery garlic chutney & crisp besan crumbs\', isBestseller: true, isVegetarian: true },\n      { id: \'m2\', name: \'Special Sukha Chutney Pav (2 pcs)\', price: 15, description: \'Freshly baked pav stuffed with spiced roasted garlic-coconut blend\', isVegetarian: true },\n      { id: \'m3\', name: \'Crisp Kanda Bhajji Plate (Onion Pakora)\', price: 35, description: \'Freshly shredded onion fritters tossed with chaat masala\', isBestseller: true, isVegetarian: true },\n      { id: \'m4\', name: \'Chilled Spiced Masala Chaas\', price: 15, description: \'Traditional roasted cumin & mint spiced churned buttermilk\', isVegetarian: true }\n    ],\n    photos: [\n      \'https://images.unsplash.com/photo-1626777552726-4a6b54c97e46?auto=format&fit=crop&w=1200&q=85\',\n      \'https://images.unsplash.com/photo-1601050690597-df0568f70950?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1546833999-b9f581a1996d?auto=format&fit=crop&w=1000&q=80\'\n    ]\n  },\n  {\n    id: \'spot-mum-2\',\n    name: \'Cannon Sizzling Pav Bhaji Corner\',\n    region: \'mumbai\',\n    regionLabel: \'Fort, Mumbai (MH)\',\n    category: \'Pav Bhaji & Griddle\',\n    image: \'https://images.unsplash.com/photo-1606491956689-2ea866880c84?auto=format&fit=crop&w=1200&q=85\',\n    thumbnail: \'https://images.unsplash.com/photo-1606491956689-2ea866880c84?auto=format&fit=crop&w=300&q=70\',\n    rating: 4.8,\n    reviewCount: 2150,\n    priceRange: \'\342\202\271\',\n    topDeal: {\n      item: \'Amul Butter Pav Bhaji + 2 Maskapav\',\n      price: 90,\n      badge: \'Legendary Butter Bhaji \342\202\27190\'\n    },\n    distanceMeters: 58,\n    walkingTimeSeconds: 45,\n    stepsCount: 76,\n    bearingDegrees: 110,\n    address: \'Opposite CSMT Railway Station, Fort, Mumbai, Maharashtra 400001\',\n    openingHours: \'7:00 AM \342\200\223 11:30 PM\',\n    isOpenNow: true,\n    dietaryTags: [\'100% Pure Veg\', \'Amul Butter\', \'Jain Bhaji Available\'],\n    paymentTypes: [\'UPI / GPay\', \'Cash\', \'PhonePe / Paytm\', \'Card\'],\n    description: \'A Mumbai legend serving mashed vegetable bhaji simmered on massive cast-iron tawas loaded with slabs of golden Amul butter and fragrant Pav Bhaji masala.\',\n    secretTip: \'Ask for \"Khadak Pav\" (extra crispy toasted buttered pav) and extra lemon wedges with spiced onions.\',\n    menu: [\n      { id: \'c1\', name: \'Special Amul Butter Pav Bhaji\', price: 90, description: \'Rich spiced mixed vegetable gravy topped with butter block & 2 hot buttered pavs\', isBestseller: true, isVegetarian: true },\n      { id: \'c2\', name: \'Amul Cheese Burst Pav Bhaji\', price: 120, description: \'Generous snowfall of processed Amul cheese grated over sizzling bhaji\', isBestseller: true, isVegetarian: true },\n      { id: \'c3\', name: \'Extra Butter Tawa Toasted Pav (Pair)\', price: 20, description: \'Two soft pavs seared on the buttery masala griddle\', isVegetarian: true },\n      { id: \'c4\', name: \'Fresh Masala Jeera Nimbu Soda\', price: 25, description: \'Fizzy lemon soda churned with black salt and roasted cumin\', isVegetarian: true }\n    ],\n    photos: [\n      \'https://images.unsplash.com/photo-1606491956689-2ea866880c84?auto=format&fit=crop&w=1200&q=85\',\n      \'https://images.unsplash.com/photo-1589301760014-d929f3979dbc?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1546833999-b9f581a1996d?auto=format&fit=crop&w=1000&q=80\'\n    ]\n  },\n  {\n    id: \'spot-mum-3\',\n    name: \'Kyani Heritage Bakery & Irani Chai\',\n    region: \'mumbai\',\n    regionLabel: \'Marine Lines, Mumbai (MH)\',\n    category: \'Filter Coffee & Chai\',\n    image: \'https://images.unsplash.com/photo-1577968897966-3d4325b36b61?auto=format&fit=crop&w=1200&q=85\',\n    thumbnail: \'https://images.unsplash.com/photo-1577968897966-3d4325b36b61?auto=format&fit=crop&w=300&q=70\',\n    rating: 4.9,\n    reviewCount: 3100,\n    priceRange: \'\342\202\271\',\n    topDeal: {\n      item: \'Kadak Irani Chai + Bun Maska Buttered\',\n      price: 40,\n      badge: \'Heritage Breakfast \342\202\27140\'\n    },\n    distanceMeters: 67,\n    walkingTimeSeconds: 52,\n    stepsCount: 88,\n    bearingDegrees: 280,\n    address: \'Jer Mahal Estate, 657, JSS Rd, Marine Lines, Mumbai, Maharashtra 400002\',\n    openingHours: \'7:00 AM \342\200\223 8:30 PM\',\n    isOpenNow: true,\n    dietaryTags: [\'Vegetarian Friendly\', \'Fresh Baked Daily\', \'Irani Chai\'],\n    paymentTypes: [\'UPI / GPay\', \'Cash\', \'PhonePe / Paytm\'],\n    description: \'Operating continuously since 1904. Savor velvety caramelized Irani chai in glass tumblers with fluffy fresh-baked buns smeared with creamy salted butter.\',\n    secretTip: \'Dip the warm, soft Bun Maska right into the hot chai for 3 seconds before taking each bite.\',\n    menu: [\n      { id: \'k1\', name: \'Special Irani Cutting Chai\', price: 18, description: \'Slow-simmered rich milk tea infused with cardamom and lemongrass\', isBestseller: true, isVegetarian: true },\n      { id: \'k2\', name: \'Traditional Bun Maska\', price: 22, description: \'Ultra-soft bakery bun loaded with whipped salted white butter\', isBestseller: true, isVegetarian: true },\n      { id: \'k3\', name: \'Cardamom Mawa Cake Slice\', price: 25, description: \'Dense, rich Parsi bakery cake infused with caramelized milk solids\', isVegetarian: true },\n      { id: \'k4\', name: \'Spiced Cheese Omelette Pav / Veg Pao\', price: 55, description: \'Two fresh eggs/herbed paneer whisked with green chilies, onions & pav\' }\n    ],\n    photos: [\n      \'https://images.unsplash.com/photo-1577968897966-3d4325b36b61?auto=format&fit=crop&w=1200&q=85\',\n      \'https://images.unsplash.com/photo-1544787219-7f47ccb76574?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1561047029-3000c68339ca?auto=format&fit=crop&w=1000&q=80\'\n    ]\n  },\n  {\n    id: \'spot-mum-4\',\n    name: \'Kalyan Chowpatty Bhel & Sev Puri Counter\',\n    region: \'mumbai\',\n    regionLabel: \'Chowpatty Beach, Mumbai (MH)\',\n    category: \'Vada Pav & Chaat\',\n    image: \'https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?auto=format&fit=crop&w=1200&q=85\',\n    thumbnail: \'https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?auto=format&fit=crop&w=300&q=70\',\n    rating: 4.8,\n    reviewCount: 980,\n    priceRange: \'\342\202\271\',\n    topDeal: {\n      item: \'Loaded Sev Batata Puri with Raw Mango\',\n      price: 50,\n      badge: \'Beachside Crunch \342\202\27150\'\n    },\n    distanceMeters: 74,\n    walkingTimeSeconds: 58,\n    stepsCount: 96,\n    bearingDegrees: 195,\n    address: \'Stall No. 8, Girgaon Chowpatty Promenade, Mumbai, Maharashtra 400007\',\n    openingHours: \'2:00 PM \342\200\223 12:00 AM\',\n    isOpenNow: true,\n    dietaryTags: [\'100% Vegetarian\', \'No Onion/Garlic Available\', \'Crispy Street Chaat\'],\n    paymentTypes: [\'UPI / GPay\', \'Cash\', \'PhonePe / Paytm\'],\n    description: \'Crispy flat puris topped with seasoned diced potatoes, finely chopped onions, raw shredded mango, tangy tamarind and spicy mint-coriander chutneys under a mountain of golden nylon sev.\',\n    secretTip: \'Ask for a \"Sukha Puri\" (dry seasoned crisp flatbread) at the end \342\200\224 it is a customary free treat!\',\n    menu: [\n      { id: \'kp1\', name: \'Special Mumbai Sev Batata Puri (6 pcs)\', price: 50, description: \'Crisp puris layered with spiced potatoes, 3 chutneys & fine nylon sev\', isBestseller: true, isVegetarian: true },\n      { id: \'kp2\', name: \'Beachside Geela Bhelpuri\', price: 45, description: \'Puffed rice, crisps, peanuts & tangy kairi tossed on the spot\', isBestseller: true, isVegetarian: true },\n      { id: \'kp3\', name: \'Cooling Dahi Batata Puri (SPDP)\', price: 60, description: \'Puffed puris stuffed with potatoes and sweet chilled whipped curd\', isVegetarian: true },\n      { id: \'kp4\', name: \'Chowpatty Kesar Pista Matka Kulfi\', price: 40, description: \'Dense rich reduced milk frozen ice cream with pistachios & saffron\', isVegetarian: true }\n    ],\n    photos: [\n      \'https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?auto=format&fit=crop&w=1200&q=85\',\n      \'https://images.unsplash.com/photo-1601050690597-df0568f70950?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=1000&q=80\'\n    ]\n  },\n  {\n    id: \'spot-mum-5\',\n    name: \'Tibbs Original Frankie & Grill Station\',\n    region: \'mumbai\',\n    regionLabel: \'Bandra West, Mumbai (MH)\',\n    category: \'Sandwiches & Frankies\',\n    image: \'https://images.unsplash.com/photo-1626804475297-41608ea09aeb?auto=format&fit=crop&w=1200&q=85\',\n    thumbnail: \'https://images.unsplash.com/photo-1626804475297-41608ea09aeb?auto=format&fit=crop&w=300&q=70\',\n    rating: 4.8,\n    reviewCount: 1420,\n    priceRange: \'\342\202\271\',\n    topDeal: {\n      item: \'Paneer Schezwan Masala Frankie Roll\',\n      price: 70,\n      badge: \'Original Frankie \342\202\27170\'\n    },\n    distanceMeters: 82,\n    walkingTimeSeconds: 65,\n    stepsCount: 108,\n    bearingDegrees: 340,\n    address: \'Near Linking Road Junction, Bandra West, Mumbai, Maharashtra 400050\',\n    openingHours: \'11:00 AM \342\200\223 11:30 PM\',\n    isOpenNow: true,\n    dietaryTags: [\'Vegetarian Options\', \'Secret Spice Blend\', \'Fresh Roti Roll\'],\n    paymentTypes: [\'UPI / GPay\', \'Cash\', \'PhonePe / Paytm\', \'Card\'],\n    description: \'Invented in Mumbai in 1969. Fresh flaky handmade flatbread rolled with spiced fillings, crunchy pickled onions, and their proprietary 15-spice Frankie masala.\',\n    secretTip: \'Ask for \"Extra Frankie Masala & Vinegar Chilies\" dusted across the inner roll.\',\n    menu: [\n      { id: \'tb1\', name: \'Spicy Paneer Schezwan Frankie\', price: 70, description: \'Charred paneer cubes tossed in garlic chili sauce with crisp slaw\', isBestseller: true, isVegetarian: true },\n      { id: \'tb2\', name: \'Classic Veggie Potato Masala Frankie\', price: 50, description: \'Spiced potato roll with vinegar onions and signature seasoning\', isVegetarian: true },\n      { id: \'tb3\', name: \'Cheese Burst Veg Frankie\', price: 75, description: \'Molten cheddar cheese layer rolled with roasted vegetables\', isBestseller: true, isVegetarian: true },\n      { id: \'tb4\', name: \'Fresh Cold Sweet Sugarcane Juice\', price: 25, description: \'Freshly crushed sugarcane juice with ginger, lemon & mint\', isVegetarian: true }\n    ],\n    photos: [\n      \'https://images.unsplash.com/photo-1626804475297-41608ea09aeb?auto=format&fit=crop&w=1200&q=85\',\n      \'https://images.unsplash.com/photo-1565299585323-38d6b0865b47?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1540420773420-3366772f4999?auto=format&fit=crop&w=1000&q=80\'\n    ]\n  },\n  {\n    id: \'spot-mum-6\',\n    name: \'Siddhivinayak Bombay Grill Sandwich\',\n    region: \'mumbai\',\n    regionLabel: \'Dadar, Mumbai (MH)\',\n    category: \'Sandwiches & Frankies\',\n    image: \'https://images.unsplash.com/photo-1528735602780-2552fd46c7af?auto=format&fit=crop&w=1200&q=85\',\n    thumbnail: \'https://images.unsplash.com/photo-1528735602780-2552fd46c7af?auto=format&fit=crop&w=300&q=70\',\n    rating: 4.9,\n    reviewCount: 1680,\n    priceRange: \'\342\202\271\',\n    topDeal: {\n      item: \'Jumbo Butter Masala Toast Sandwich\',\n      price: 60,\n      badge: \'Crispy Grilled Cheese \342\202\27160\'\n    },\n    distanceMeters: 92,\n    walkingTimeSeconds: 72,\n    stepsCount: 120,\n    bearingDegrees: 155,\n    address: \'Near Portuguese Church, Dadar West, Mumbai, Maharashtra 400028\',\n    openingHours: \'9:00 AM \342\200\223 10:30 PM\',\n    isOpenNow: true,\n    dietaryTags: [\'100% Vegetarian\', \'Amul Butter Grilled\', \'Jain Options\'],\n    paymentTypes: [\'UPI / GPay\', \'Cash\', \'PhonePe / Paytm\'],\n    description: \'Triple-decker bread stuffed with sliced potatoes, cucumbers, tomatoes, bell peppers, beetroot, and spicy coriander chutney, toasted on open-flame cast-iron tongs.\',\n    secretTip: \'Ask the master to cut it into 8 bite-size squares and shower it with nylon sev and butter.\',\n    menu: [\n      { id: \'sw1\', name: \'Jumbo Mumbai Veg Grilled Toast\', price: 60, description: \'Spiced potatoes, veggies, green mint chutney & chaat masala grilled crisp\', isBestseller: true, isVegetarian: true },\n      { id: \'sw2\', name: \'Amul Cheese Chilli Toast Sandwich\', price: 80, description: \'Grated cheese, chopped green capsicum, green chilies & black pepper\', isBestseller: true, isVegetarian: true },\n      { id: \'sw3\', name: \'Traditional Bombay Toast Sandwich\', price: 45, description: \'Classic 2-layer butter and potato spiced toast with red chutney\', isVegetarian: true },\n      { id: \'sw4\', name: \'Fresh Alfonso Mango Thick Lassi\', price: 40, description: \'Sweet thick yogurt churned with real Alfonso mango pulp\', isVegetarian: true }\n    ],\n    photos: [\n      \'https://images.unsplash.com/photo-1528735602780-2552fd46c7af?auto=format&fit=crop&w=1200&q=85\',\n      \'https://images.unsplash.com/photo-1550547660-d9450f859349?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1563245372-f21724e3856d?auto=format&fit=crop&w=1000&q=80\'\n    ]\n  },\n\n  // TAMIL NADU SPOTS\n  {\n    id: \'spot-tn-1\',\n    name: \'Murugan Ghee Podi Idli & Tiffin Stall\',\n    region: \'tamilnadu\',\n    regionLabel: \'T. Nagar, Chennai (TN)\',\n    category: \'Dosa & Tiffins\',\n    image: \'https://images.unsplash.com/photo-1589301760014-d929f3979dbc?auto=format&fit=crop&w=1200&q=85\',\n    thumbnail: \'https://images.unsplash.com/photo-1589301760014-d929f3979dbc?auto=format&fit=crop&w=300&q=70\',\n    rating: 4.9,\n    reviewCount: 2900,\n    priceRange: \'\342\202\271\',\n    topDeal: {\n      item: \'2x Steaming Ghee Podi Thatte Idli + 4 Chutneys\',\n      price: 45,\n      badge: \'Hot Ghee Gunpowder \342\202\27145\'\n    },\n    distanceMeters: 54,\n    walkingTimeSeconds: 42,\n    stepsCount: 70,\n    bearingDegrees: 45,\n    address: \'77/1 GN Chetty Road, T. Nagar, Chennai, Tamil Nadu 600017\',\n    openingHours: \'6:30 AM \342\200\223 11:00 PM\',\n    isOpenNow: true,\n    dietaryTags: [\'100% Pure Veg\', \'Gluten-Free Idlis\', \'Unlimited 4 Chutneys\'],\n    paymentTypes: [\'UPI / GPay\', \'Cash\', \'PhonePe / Paytm\', \'Card\'],\n    description: \'Piping hot cloud-soft steamed idlis drenched in fragrant hot country cow ghee and fiery roasted gun-powder (idli podi), served with four fresh handmade chutneys on banana leaves.\',\n    secretTip: \'You can ask for generous extra bowls of their signature spicy coriander and sweet tomato-onion chutneys for free!\',\n    menu: [\n      { id: \'mrg1\', name: \'Signature Ghee Podi Idli (2 pcs)\', price: 45, description: \'Steaming fluffy rice idlis bathed in melted cow ghee and spicy dal podi\', isBestseller: true, isVegetarian: true, isGlutenFree: true },\n      { id: \'mrg2\', name: \'Crispy Medu Vada with Hot Sambar\', price: 25, description: \'Golden fried crispy lentil doughnut with peppercorn & curry leaves\', isBestseller: true, isVegetarian: true },\n      { id: \'mrg3\', name: \'Golden Ghee Roast Masala Dosa\', price: 75, description: \'Crispy fermented crepe smeared with pure ghee and potato masala\', isVegetarian: true, isGlutenFree: true },\n      { id: \'mrg4\', name: \'Traditional Filter Degree Kaapi\', price: 20, description: \'Chicory blend decoction frothed with boiling rich creamy milk in brass davarah\', isVegetarian: true }\n    ],\n    photos: [\n      \'https://images.unsplash.com/photo-1589301760014-d929f3979dbc?auto=format&fit=crop&w=1200&q=85\',\n      \'https://images.unsplash.com/photo-1626777552726-4a6b54c97e46?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1546833999-b9f581a1996d?auto=format&fit=crop&w=1000&q=80\'\n    ]\n  },\n  {\n    id: \'spot-tn-2\',\n    name: \'Triplicane Ratna Sambar Dosa Corner\',\n    region: \'tamilnadu\',\n    regionLabel: \'Triplicane, Chennai (TN)\',\n    category: \'Dosa & Tiffins\',\n    image: \'https://images.unsplash.com/photo-1668236543090-82eba5ee5976?auto=format&fit=crop&w=1200&q=85\',\n    thumbnail: \'https://images.unsplash.com/photo-1668236543090-82eba5ee5976?auto=format&fit=crop&w=300&q=70\',\n    rating: 4.9,\n    reviewCount: 2420,\n    priceRange: \'\342\202\271\',\n    topDeal: {\n      item: \'Crisp Sambar Dosa with Unlimited Pouring Sambar\',\n      price: 65,\n      badge: \'Legendary Sambar Tank \342\202\27165\'\n    },\n    distanceMeters: 62,\n    walkingTimeSeconds: 48,\n    stepsCount: 82,\n    bearingDegrees: 130,\n    address: \'255 Triplicane High Road, Chennai, Tamil Nadu 600005\',\n    openingHours: \'7:00 AM \342\200\223 10:30 PM\',\n    isOpenNow: true,\n    dietaryTags: [\'100% Vegetarian\', \'Heritage Recipe Since 1948\', \'Jain Sambar Available\'],\n    paymentTypes: [\'UPI / GPay\', \'Cash\', \'PhonePe / Paytm\'],\n    description: \'Renowned throughout Tamil Nadu for their unique sweet-and-spicy drumstick & shallot sambar poured generously from large stainless jugs over paper-crisp golden dosas.\',\n    secretTip: \'Ask the waiter to drown your dosa completely in steaming hot sambar until it floats!\',\n    menu: [\n      { id: \'rt1\', name: \'Original Ratna Sambar Dosa\', price: 65, description: \'Golden crisp dosa immersed in legendary shallot & drumstick sambar\', isBestseller: true, isVegetarian: true, isGlutenFree: true },\n      { id: \'rt2\', name: \'Crisp Onion Uthappam\', price: 60, description: \'Thick soft fermented pancake griddled with caramelised shallots & chilies\', isVegetarian: true, isGlutenFree: true },\n      { id: \'rt3\', name: \'Hot Melt-in-Mouth Rava Kesari\', price: 35, description: \'Sweet semolina dessert infused with ghee, saffron & roasted cashews\', isBestseller: true, isVegetarian: true },\n      { id: \'rt4\', name: \'Fresh Madurai Rose Milk Cooler\', price: 25, description: \'Chilled rich milk blended with fragrant rose essence and sabja basil seeds\', isVegetarian: true }\n    ],\n    photos: [\n      \'https://images.unsplash.com/photo-1668236543090-82eba5ee5976?auto=format&fit=crop&w=1200&q=85\',\n      \'https://images.unsplash.com/photo-1601050690597-df0568f70950?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1546833999-b9f581a1996d?auto=format&fit=crop&w=1000&q=80\'\n    ]\n  },\n  {\n    id: \'spot-tn-3\',\n    name: \'Madurai Famous Jigarthanda Stand\',\n    region: \'tamilnadu\',\n    regionLabel: \'Madurai / Chennai (TN)\',\n    category: \'Desserts & Drinks\',\n    image: \'https://images.unsplash.com/photo-1572490122747-3968b75cc699?auto=format&fit=crop&w=1200&q=85\',\n    thumbnail: \'https://images.unsplash.com/photo-1572490122747-3968b75cc699?auto=format&fit=crop&w=300&q=70\',\n    rating: 4.9,\n    reviewCount: 3400,\n    priceRange: \'\342\202\271\',\n    topDeal: {\n      item: \'Special Royal Jigarthanda with Basundi Ice Cream\',\n      price: 50,\n      badge: \'Madurai Special \342\202\27150\'\n    },\n    distanceMeters: 70,\n    walkingTimeSeconds: 55,\n    stepsCount: 92,\n    bearingDegrees: 220,\n    address: \'East Marret Street, Madurai / T. Nagar Branch, Tamil Nadu\',\n    openingHours: \'10:00 AM \342\200\223 11:30 PM\',\n    isOpenNow: true,\n    dietaryTags: [\'100% Vegetarian\', \'Badam Pisin (Almond Gum)\', \'Natural Cooling Drink\'],\n    paymentTypes: [\'UPI / GPay\', \'Cash\', \'PhonePe / Paytm\'],\n    description: \'Literally meaning \"Heart Cooler\" in Urdu/Tamil. A royal Mughal-Madurai drink made with pure almond gum (badam pisin), nannari root syrup, condensed milk, and topped with homemade basundi ice cream.\',\n    secretTip: \'Stir vigorously with your spoon to mix the jelly-like badam pisin from the bottom with the top basundi cream.\',\n    menu: [\n      { id: \'jg1\', name: \'Special Royal Madurai Jigarthanda\', price: 50, description: \'Almond gum, condensed milk, caramelised nannari & rich basundi scoop\', isBestseller: true, isVegetarian: true },\n      { id: \'jg2\', name: \'Nannari Root Sherbet Cooler\', price: 25, description: \'Herbal cooling sarsaparilla syrup with fresh squeezed lime & crushed ice\', isVegetarian: true },\n      { id: \'jg3\', name: \'Authentic Madurai Palkova Cup\', price: 35, description: \'Slow-simmered rich caramelized milk sweet with zero artificial flavors\', isBestseller: true, isVegetarian: true },\n      { id: \'jg4\', name: \'Elaneer (Tender Coconut) Payasam\', price: 40, description: \'Tender coconut flesh blended with coconut milk, cardamom & cashews\', isVegetarian: true }\n    ],\n    photos: [\n      \'https://images.unsplash.com/photo-1572490122747-3968b75cc699?auto=format&fit=crop&w=1200&q=85\',\n      \'https://images.unsplash.com/photo-1544787219-7f47ccb76574?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1561047029-3000c68339ca?auto=format&fit=crop&w=1000&q=80\'\n    ]\n  },\n  {\n    id: \'spot-tn-4\',\n    name: \'Chennai Fast Kothu Parotta & Salna Stall\',\n    region: \'tamilnadu\',\n    regionLabel: \'Anna Salai, Chennai (TN)\',\n    category: \'Parotta & Biryani\',\n    image: \'https://images.unsplash.com/photo-1601050690597-df0568f70950?auto=format&fit=crop&w=1200&q=85\',\n    thumbnail: \'https://images.unsplash.com/photo-1601050690597-df0568f70950?auto=format&fit=crop&w=300&q=70\',\n    rating: 4.8,\n    reviewCount: 1750,\n    priceRange: \'\342\202\271\',\n    topDeal: {\n      item: \'Sizzling Spiced Veg/Egg Kothu Parotta + Salna Gravy\',\n      price: 80,\n      badge: \'Street Sizzle \342\202\27180\'\n    },\n    distanceMeters: 78,\n    walkingTimeSeconds: 60,\n    stepsCount: 102,\n    bearingDegrees: 310,\n    address: \'Near Mount Road / Anna Salai Junction, Chennai, Tamil Nadu 600002\',\n    openingHours: \'4:00 PM \342\200\223 1:30 AM\',\n    isOpenNow: true,\n    dietaryTags: [\'Veg & Egg Options\', \'Live Tawa Clang\', \'Spicy Salna\'],\n    paymentTypes: [\'UPI / GPay\', \'Cash\', \'PhonePe / Paytm\'],\n    description: \'Layered flaky parottas shredded on a red-hot iron griddle with twin metal blades, stir-fried vigorously with eggs/mushrooms, onions, green chilies, and aromatic Madurai street salna.\',\n    secretTip: \'Watch the theatrical rhythm of the master chopping the parotta \342\200\224 ask for extra spicy pepper salna on the side!\',\n    menu: [\n      { id: \'kp_tn1\', name: \'Special Egg Kothu Parotta Plate\', price: 80, description: \'Shredded parotta minced with 2 farm eggs, onions, curry leaves & spiced gravy\', isBestseller: true },\n      { id: \'kp_tn2\', name: \'Flaky Bun Parotta (2 pcs) with Veg Salna\', price: 45, description: \'Soft, puffy coin parottas with rich coconut-poppy seed salna\', isBestseller: true, isVegetarian: true },\n      { id: \'kp_tn3\', name: \'Crispy Street Gobi 65 / Mushroom 65\', price: 65, description: \'Curry leaf marinated crispy cauliflower florets with onions & lemons\', isVegetarian: true },\n      { id: \'kp_tn4\', name: \'Curry Leaf Moru (Spiced Buttermilk)\', price: 20, description: \'Cold churned yogurt tempered with mustard, green chilies and ginger\', isVegetarian: true }\n    ],\n    photos: [\n      \'https://images.unsplash.com/photo-1601050690597-df0568f70950?auto=format&fit=crop&w=1200&q=85\',\n      \'https://images.unsplash.com/photo-1589301760014-d929f3979dbc?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1546833999-b9f581a1996d?auto=format&fit=crop&w=1000&q=80\'\n    ]\n  },\n  {\n    id: \'spot-tn-5\',\n    name: \'Mylapore Mami Tiffin & Filter Kaapi Corner\',\n    region: \'tamilnadu\',\n    regionLabel: \'Mylapore, Chennai (TN)\',\n    category: \'Filter Coffee & Chai\',\n    image: \'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=1200&q=85\',\n    thumbnail: \'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=300&q=70\',\n    rating: 4.9,\n    reviewCount: 3200,\n    priceRange: \'\342\202\271\',\n    topDeal: {\n      item: \'Frothy Brass Tumbler Filter Kaapi + 4 Paniyaram\',\n      price: 55,\n      badge: \'Mylapore Heritage \342\202\27155\'\n    },\n    distanceMeters: 86,\n    walkingTimeSeconds: 68,\n    stepsCount: 112,\n    bearingDegrees: 85,\n    address: \'Near Kapaleeshwarar Temple South Mada St, Mylapore, Chennai, Tamil Nadu 600004\',\n    openingHours: \'6:00 AM \342\200\223 9:00 PM\',\n    isOpenNow: true,\n    dietaryTags: [\'100% Brahmin Pure Veg\', \'Fresh Filter Coffee\', \'Traditional Tiffins\'],\n    paymentTypes: [\'UPI / GPay\', \'Cash\', \'PhonePe / Paytm\'],\n    description: \'Nestled by the historic Kapaleeshwarar Temple. Serving authentic brass davarah filter coffee brewed from freshly roasted plantation coffee beans paired with hot crispy kuzhi paniyarams.\',\n    secretTip: \'Pour the coffee between the davarah and tumbler twice from a height of 1 foot to aerate the rich foam before sipping.\',\n    menu: [\n      { id: \'mp1\', name: \'Authentic Kumbakonam Degree Filter Kaapi\', price: 20, description: \'First-drip chicory decoction with boiled full-cream milk in brass tumbler\', isBestseller: true, isVegetarian: true },\n      { id: \'mp2\', name: \'Kara Kuzhi Paniyaram (6 pcs) with Chutney\', price: 40, description: \'Crispy round dumplings seasoned with mustard, ginger, onions & curry leaves\', isBestseller: true, isVegetarian: true },\n      { id: \'mp3\', name: \'Ghee Cashew Ven Pongal + Sambar\', price: 50, description: \'Silky rice-moong dal porridge tempered with black peppercorns & cashews\', isBestseller: true, isVegetarian: true },\n      { id: \'mp4\', name: \'Jaggery Sweet Kozhukattai (2 pcs)\', price: 25, description: \'Steamed rice dumpling filled with grated coconut and organic jaggery\', isVegetarian: true }\n    ],\n    photos: [\n      \'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=1200&q=85\',\n      \'https://images.unsplash.com/photo-1577968897966-3d4325b36b61?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1544787219-7f47ccb76574?auto=format&fit=crop&w=1000&q=80\'\n    ]\n  },\n  {\n    id: \'spot-tn-6\',\n    name: \'Velu Chettinad Street Tiffin & Kari Dosa\',\n    region: \'tamilnadu\',\n    regionLabel: \'Madurai / Coimbatore (TN)\',\n    category: \'Dosa & Tiffins\',\n    image: \'https://images.unsplash.com/photo-1546833999-b9f581a1996d?auto=format&fit=crop&w=1200&q=85\',\n    thumbnail: \'https://images.unsplash.com/photo-1546833999-b9f581a1996d?auto=format&fit=crop&w=300&q=70\',\n    rating: 4.8,\n    reviewCount: 1620,\n    priceRange: \'\342\202\271\',\n    topDeal: {\n      item: \'Three-Tier Madurai Kari / Mushroom Dosa\',\n      price: 95,\n      badge: \'Chettinad Sensation \342\202\27195\'\n    },\n    distanceMeters: 96,\n    walkingTimeSeconds: 76,\n    stepsCount: 126,\n    bearingDegrees: 175,\n    address: \'Town Hall Road, Madurai, Tamil Nadu 625001\',\n    openingHours: \'5:00 PM \342\200\223 11:30 PM\',\n    isOpenNow: true,\n    dietaryTags: [\'Chettinad Spiced\', \'Egg / Mushroom Options\', \'Stone Ground Chutneys\'],\n    paymentTypes: [\'UPI / GPay\', \'Cash\', \'PhonePe / Paytm\'],\n    description: \'Thick fermented rice base, smeared with whipped egg or spiced mushroom paste, topped with slow-roasted Chettinad pepper gravy and griddled to perfection.\',\n    secretTip: \'Ask for their spicy dry roasted garlic podi sprinkled generously over the top crust.\',\n    menu: [\n      { id: \'vl1\', name: \'Madurai Special Egg / Mushroom Kari Dosa\', price: 95, description: \'Triple-layer thick dosa topped with spiced gravy and fresh coriander\', isBestseller: true },\n      { id: \'vl2\', name: \'Chettinad Black Pepper Ghee Roast\', price: 70, description: \'Crispy cone dosa dusted with Tellicherry black pepper and ghee\', isVegetarian: true, isGlutenFree: true },\n      { id: \'vl3\', name: \'Golden Egg / Podi Paniyaram Plate (6 pcs)\', price: 45, description: \'Puffed griddle dumplings tossed in spicy country podi and sesame oil\' },\n      { id: \'vl4\', name: \'Nannari Sarbath with Sabja Seeds\', price: 25, description: \'Sweet aromatic cooling herbal drink with crushed ice & lemon\', isVegetarian: true }\n    ],\n    photos: [\n      \'https://images.unsplash.com/photo-1546833999-b9f581a1996d?auto=format&fit=crop&w=1200&q=85\',\n      \'https://images.unsplash.com/photo-1668236543090-82eba5ee5976?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1601050690597-df0568f70950?auto=format&fit=crop&w=1000&q=80\'\n    ]\n  }\n];\n"
