  file_change {
    absolute_path_uri: "file:///src/components/SpotDetailModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { FoodSpot } from \'../types\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { \n  X, \n  Navigation, \n  Flame, \n  Heart, \n  Clock, \n  CreditCard, \n  Check, \n  Sparkles, \n  MapPin, \n  ChevronRight,\n  Share2\n} from \'lucide-react\';\nimport { FastImage } from \'./FastImage\';\nimport { sound } from \'../utils/audioFeedback\';\n\ninterface SpotDetailModalProps {\n  spot: FoodSpot | null;\n  onClose: () => void;\n  onNavigate: (spot: FoodSpot) => void;\n  onToggleSave: (spot: FoodSpot) => void;\n  isSaved?: boolean;\n}\n\nexport const SpotDetailModal: React.FC<SpotDetailModalProps> = ({\n  spot,\n  onClose,\n  onNavigate,\n  onToggleSave,\n  isSaved = false,\n}) => {\n  const [activePhotoIdx, setActivePhotoIdx] = useState(0);\n\n  if (!spot) return null;\n\n  return (\n    <AnimatePresence>\n      <div className=\"fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 bg-stone-950/80 backdrop-blur-md\">\n        <motion.div\n          initial={{ opacity: 0, y: 100 }}\n          animate={{ opacity: 1, y: 0 }}\n          exit={{ opacity: 0, y: 100 }}\n          transition={{ type: \'spring\', damping: 25, stiffness: 300 }}\n          className=\"w-full max-w-lg bg-stone-900 border border-stone-800 rounded-t-3xl sm:rounded-3xl max-h-[90vh] flex flex-col shadow-2xl overflow-hidden\"\n        >\n          {/* Image carousel / Hero */}\n          <div className=\"relative h-64 sm:h-72 w-full shrink-0 bg-stone-950\">\n            <FastImage\n              src={spot.photos[activePhotoIdx] || spot.image}\n              alt={spot.name}\n              className=\"w-full h-full object-cover\"\n            />\n            <div className=\"absolute inset-0 bg-gradient-to-t from-stone-900 via-stone-900/20 to-black/50\" />\n\n            {/* Top Close and Action Icons */}\n            <div className=\"absolute top-4 left-4 right-4 flex items-center justify-between z-20\">\n              <span className=\"px-3 py-1 rounded-full bg-stone-950/80 backdrop-blur-md border border-amber-500/40 text-amber-300 text-xs font-bold shadow-lg\">\n                {spot.distanceMeters}m away \342\200\242 {spot.stepsCount} steps\n              </span>\n              <div className=\"flex items-center gap-2\">\n                <button\n                  onClick={() => {\n                    sound.playClick();\n                    onToggleSave(spot);\n                  }}\n                  className={`p-2 rounded-full backdrop-blur-md border transition-all ${\n                    isSaved\n                      ? \'bg-rose-500/20 border-rose-500/50 text-rose-400\'\n                      : \'bg-stone-950/70 border-stone-700/60 text-stone-200\'\n                  }`}\n                >\n                  <Heart className={`w-4 h-4 ${isSaved ? \'fill-rose-500\' : \'\'}`} />\n                </button>\n                <button\n                  onClick={() => {\n                    sound.playClick();\n                    onClose();\n                  }}\n                  className=\"p-2 rounded-full bg-stone-950/70 backdrop-blur-md border border-stone-700 text-stone-200 hover:text-white\"\n                >\n                  <X className=\"w-4 h-4\" />\n                </button>\n              </div>\n            </div>\n\n            {/* Photo thumbnails */}\n            {spot.photos.length > 1 && (\n              <div className=\"absolute bottom-3 right-4 flex gap-1.5 z-20\">\n                {spot.photos.map((photo, i) => (\n                  <button\n                    key={i}\n                    onClick={() => {\n                      sound.playClick();\n                      setActivePhotoIdx(i);\n                    }}\n                    className={`w-9 h-9 rounded-lg overflow-hidden border-2 transition-all ${\n                      activePhotoIdx === i ? \'border-amber-400 scale-105\' : \'border-stone-600 opacity-60\'\n                    }`}\n                  >\n                    <img src={photo} alt=\"\" referrerPolicy=\"no-referrer\" className=\"w-full h-full object-cover\" />\n                  </button>\n                ))}\n              </div>\n            )}\n          </div>\n\n          {/* Scrollable Content */}\n          <div className=\"p-5 overflow-y-auto space-y-5 flex-1\">\n            {/* Title & Ratings */}\n            <div>\n              <div className=\"flex items-center justify-between text-xs text-stone-400 mb-1\">\n                <span className=\"px-2 py-0.5 rounded bg-stone-800 text-stone-300 font-medium\">\n                  {spot.category}\n                </span>\n                <span className=\"text-amber-400 font-bold\">\n                  \342\230\205 {spot.rating} ({spot.reviewCount} reviews)\n                </span>\n              </div>\n              <h2 className=\"text-xl font-bold text-stone-100\">{spot.name}</h2>\n              <p className=\"text-xs text-stone-400 flex items-center gap-1 mt-1\">\n                <MapPin className=\"w-3.5 h-3.5 text-stone-500\" />\n                <span>{spot.address}</span>\n              </p>\n            </div>\n\n            {/* Top Deal Highlight */}\n            <div className=\"p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-between\">\n              <div className=\"flex items-center gap-2.5\">\n                <div className=\"w-9 h-9 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center\">\n                  <Flame className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <div className=\"text-[11px] font-bold text-amber-400 uppercase tracking-wide\">\n                    {spot.topDeal.badge}\n                  </div>\n                  <div className=\"text-xs font-bold text-stone-100\">\n                    {spot.topDeal.item}\n                  </div>\n                </div>\n              </div>\n              <div className=\"text-right\">\n                <span className=\"text-lg font-black text-amber-400\">\n                  ${spot.topDeal.price.toFixed(2)}\n                </span>\n              </div>\n            </div>\n\n            {/* Description & Secret Pro Tip */}\n            <div>\n              <h4 className=\"text-xs font-bold text-stone-300 uppercase tracking-wider mb-1.5\">\n                About this Spot\n              </h4>\n              <p className=\"text-xs text-stone-300 leading-relaxed\">\n                {spot.description}\n              </p>\n\n              <div className=\"mt-2.5 p-3 rounded-xl bg-stone-800/80 border border-stone-700/60 text-xs text-stone-300 flex items-start gap-2\">\n                <Sparkles className=\"w-4 h-4 text-amber-400 shrink-0 mt-0.5\" />\n                <div>\n                  <span className=\"font-bold text-amber-300\">Local Hack: </span>\n                  <span>{spot.secretTip}</span>\n                </div>\n              </div>\n            </div>\n\n            {/* Full Low-Budget Menu */}\n            <div>\n              <h4 className=\"text-xs font-bold text-stone-300 uppercase tracking-wider mb-2\">\n                Full Budget Menu\n              </h4>\n              <div className=\"space-y-2\">\n                {spot.menu.map((item) => (\n                  <div\n                    key={item.id}\n                    className=\"p-3 rounded-xl bg-stone-800/60 border border-stone-750 flex items-center justify-between gap-3\"\n                  >\n                    <div className=\"min-w-0\">\n                      <div className=\"flex items-center gap-2\">\n                        <span className=\"text-xs font-bold text-stone-100 truncate\">\n                          {item.name}\n                        </span>\n                        {item.isBestseller && (\n                          <span className=\"text-[9px] px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-300 font-semibold\">\n                            Top Pick\n                          </span>\n                        )}\n                      </div>\n                      <p className=\"text-[11px] text-stone-400 mt-0.5\">\n                        {item.description}\n                      </p>\n                    </div>\n                    <span className=\"text-xs font-extrabold text-amber-400 shrink-0\">\n                      ${item.price.toFixed(2)}\n                    </span>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            {/* Quick Details: Hours, Payments, Dietary */}\n            <div className=\"grid grid-cols-2 gap-2.5 text-xs\">\n              <div className=\"p-3 rounded-xl bg-stone-800/50 border border-stone-750\">\n                <div className=\"flex items-center gap-1.5 text-stone-400 mb-1\">\n                  <Clock className=\"w-3.5 h-3.5\" />\n                  <span className=\"font-semibold text-[11px]\">Hours</span>\n                </div>\n                <p className=\"text-stone-200 text-xs font-medium\">{spot.openingHours}</p>\n              </div>\n\n              <div className=\"p-3 rounded-xl bg-stone-800/50 border border-stone-750\">\n                <div className=\"flex items-center gap-1.5 text-stone-400 mb-1\">\n                  <CreditCard className=\"w-3.5 h-3.5\" />\n                  <span className=\"font-semibold text-[11px]\">Accepted</span>\n                </div>\n                <p className=\"text-stone-200 text-xs font-medium\">{spot.paymentTypes.join(\', \')}</p>\n              </div>\n            </div>\n          </div>\n\n          {/* Action Footer */}\n          <div className=\"p-4 border-t border-stone-800 bg-stone-900/95 flex items-center gap-3\">\n            <button\n              onClick={() => {\n                sound.playSuccess();\n                onNavigate(spot);\n                onClose();\n              }}\n              className=\"w-full py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-stone-950 text-xs font-bold flex items-center justify-center gap-2 shadow-lg shadow-amber-500/20 active:scale-98 transition-all\"\n            >\n              <Navigation className=\"w-4 h-4 fill-stone-950\" />\n              <span>Start Walking Navigation ({spot.distanceMeters}m)</span>\n            </button>\n          </div>\n        </motion.div>\n      </div>\n    </AnimatePresence>\n  );\n};\n"
    }
